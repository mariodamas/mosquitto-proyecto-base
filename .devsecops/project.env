# Project contract consumed by the generic DevSecOps Jenkinsfiles.
# A new project should normally change this file and the optional hooks in this
# directory, not the Jenkinsfile itself.

PROJECT_NAME="mosquitto"
PROJECT_DB_NAME="mosquitto-proyecto-base"
PROJECT_REPO_URL="https://github.com/mariodamas/mosquitto-proyecto-base"
PROJECT_LANGUAGE="C/C++"
PROJECT_PLATFORM_TYPE="linux_embedded"

BUILD_SCRIPT=".devsecops/build.sh"
BUILD_ARTIFACT="build/src/mosquitto"
HARDENING_ARTIFACT="${BUILD_ARTIFACT}"

CODEQL_LANGUAGE="cpp"
CODEQL_QUERY_PACK="cpp-queries"
CODEQL_SUITE_GLOB="cpp-security-and-quality.qls"

COVERITY_COMPILER="clang"
COVERITY_COMPTYPE="clangcc"
COVERITY_CERT_CONFIG="/opt/coverity/config/coding-standards/cert-c/cert-c-all.config"
COVERITY_MISRA_CONFIG="/opt/coverity/config/coding-standards/misrac2012/misrac2012-all.config"

VENDOR_MANIFEST_REQUIRED="true"
VENDOR_MANIFEST_PATH=".lab/sca/vendor-manifest.cdx.json"
VENDOR_MANIFEST_EVIDENCE_PATH=".lab/sca/vendor-manifest.evidence.md"
VENDOR_MANIFEST_VALIDATOR=".lab/sca/validate_vendor_manifest.py"

FUZZING_SCRIPT=".devsecops/fuzzing.sh"
FUZZING_PERSISTENT_CORPUS_NAME="${PROJECT_NAME}"

FIRMWARE_SCRIPT=".devsecops/package-firmware.sh"
FIRMWARE_TARGET_NAME="mosquitto-rootfs.tar.gz"
FIRMWARE_BINARY_INSTALL_PATH="usr/sbin/mosquitto"
FIRMWARE_VERSION="2.0.18"
FIRMWARE_OS_NAME="Mosquitto DevSecOps Lab Firmware"
FIRMWARE_OS_ID="mosquitto-devsecops-lab"
FIRMWARE_CLIENT_ARTIFACTS="build/client/mosquitto_pub:usr/bin/mosquitto_pub build/client/mosquitto_sub:usr/bin/mosquitto_sub"
FIRMWARE_PACKAGE_STATUS_PACKAGES="libc6 libssl3 libssl-dev openssl zlib1g libwebsockets17"
FIRMWARE_INIT_COMMAND="/usr/sbin/mosquitto -c /etc/mosquitto/mosquitto.conf"
