# .lab/.gitignore
# Generated artifacts on the experimental lab branch.
# These paths are produced by build_*.sh, run_campaigns.sh,
# measure_coverage.sh, and build_artifact.sh. They are regenerated per run
# and must not be committed.

# Fuzzing build outputs, working corpora, crashes, and run metadata.
# NOTE: fuzzing/corpus/ is intentionally NOT listed here — the seed corpus
# (corpus/mqtt/*.bin, corpus/cjson/*.json) is versioned and must be committed.
fuzzing/build/
fuzzing/findings/
fuzzing/coverage/
docker/output/

# Any ad-hoc result directory a phase may create at runtime.
results/
**/results/

# Common sanitizer / profiler droppings.
*.profraw
*.profdata
*.gcda
*.gcno
core
core.*

# Validation script results (also covered by **/results/ above — explicit for clarity).
validate/results/

# Editor / OS noise.
*.swp
*.swo
.DS_Store
