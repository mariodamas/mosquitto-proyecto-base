if data.get("bomFormat") != "CycloneDX":
    raise SystemExit("results/sca/sbom-source.cyclonedx.json no es CycloneDX")

print("[OK] Source SBOM JSON/CycloneDX válido")
PY

echo "=== Precheck curated vendor manifest ==="
test -s .lab/sca/vendor-manifest.cdx.json

python3 - <<'PY'
import json
from pathlib import Path

path = Path(".lab/sca/vendor-manifest.cdx.json")
