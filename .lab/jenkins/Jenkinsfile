ls -lh results/sca/grype-vendor-manifest.json || true
ls -lh results/sca/grype-db-status.json || true
'''
            }
        }

        stage('SCA - OWASP DC') {
            agent {
                docker {
                    image 'devsecops-agente:1.0'
                    reuseNode true
                    args '-u 101:103 -v /opt/devsecops-lab/vuln-dbs/owaspdc-data:/mnt/owaspdc-data:ro'
                }
            }
            steps {
                sh '''#!/usr/bin/env bash
set -euo pipefail

mkdir -p results/sca

rm -rf /tmp/owaspdc-data
mkdir -p /tmp/owaspdc-data
cp -r /mnt/owaspdc-data/. /tmp/owaspdc-data/

/opt/dependency-check/bin/dependency-check.sh \
  --project "mosquitto-devsecops-local" \
  --scan . \
  --exclude '.git/**' \
  --exclude '.github/**' \
  --exclude 'results/**' \
  --exclude 'build/**' \
  --exclude 'build-*/**' \
  --exclude 'build-coverity/**' \
  --exclude 'coverity-config/**' \
  --exclude '.codeql-cache/**' \
  --exclude '.cache/**' \
  --exclude '.codeql-home/**' \
  --format JSON \
  --format HTML \
  --out results/sca \
  --data /tmp/owaspdc-data \
  --noupdate \
  --enableExperimental \
  --disableAssembly || true

if [ -f results/sca/dependency-check-report.json ]; then
  cp results/sca/dependency-check-report.json results/sca/owaspdc.json
fi

test -s results/sca/owaspdc.json || echo "WARNING: OWASP Dependency-Check JSON report was not generated."

if [ -s results/sca/owaspdc.json ]; then
  python3 - <<'PY'
import json
from pathlib import Path

path = Path("results/sca/owaspdc.json")
json.loads(path.read_text(encoding="utf-8"))
print(f"[OK] JSON válido: {path}")
PY
fi
'''
            }
        }

        stage('Fuzzing - libFuzzer smoke') {
            agent {
                docker {
                    image 'devsecops-agente:1.0'
                    reuseNode true
                    args '-u 101:103 -v /opt/devsecops-lab/fuzzing-corpus:/opt/devsecops-lab/fuzzing-corpus:rw'
                }
            }
            steps {
                sh '''#!/usr/bin/env bash
set -euo pipefail

rm -rf .lab/fuzzing/findings

cmake -S . -B build \
  -DCMAKE_C_COMPILER=clang \
  -DCMAKE_CXX_COMPILER=clang++ \
  -DCMAKE_EXPORT_COMPILE_COMMANDS=ON \
  -DDOCUMENTATION=OFF

cd .lab/fuzzing

python3 corpus/generate_corpus.py
bash ./build_libfuzzer.sh

FUZZING_PERSISTENT_CORPUS_DIR=/opt/devsecops-lab/fuzzing-corpus/mosquitto \
ALLOW_FUZZING_FAILURES="${ALLOW_FUZZING_FAILURES}" \
CAMPAIGN_TIME=60 \
bash ./run_campaigns.sh libfuzzer

mkdir -p "${WORKSPACE}/results/fuzzing"

if [ -d "${WORKSPACE}/.lab/fuzzing/findings" ]; then
  cp -r "${WORKSPACE}/.lab/fuzzing/findings/." "${WORKSPACE}/results/fuzzing/"
fi

if [ -d "${WORKSPACE}/.lab/fuzzing/build" ]; then
  mkdir -p "${WORKSPACE}/results/fuzzing/build"
  cp -r "${WORKSPACE}/.lab/fuzzing/build/." "${WORKSPACE}/results/fuzzing/build/"
fi

echo "=== Validating fuzzing artefacts ==="
python3 - <<'PY'
import sys
from pathlib import Path

ALLOW_FAILURES = "${ALLOW_FUZZING_FAILURES}".strip().lower() == "true"

findings = Path("results/fuzzing/libfuzzer")
if not findings.exists():
    print("[WARN] No libfuzzer findings directory — harnesses may have been skipped")
    sys.exit(0)

infra_errors = []
fuzzer_failures = []

for harness_dir in sorted(findings.iterdir()):
    if not harness_dir.is_dir():
        continue

    name    = harness_dir.name
    log     = harness_dir / "run.log"
    ec_file = harness_dir / "exit_code.txt"
    meta    = harness_dir / "metadata.txt"
    corpus  = harness_dir / "corpus"

    if not log.exists():
        infra_errors.append(f"{name}: run.log missing")
        continue
    if log.stat().st_size == 0:
        infra_errors.append(f"{name}: run.log is empty")
        continue
    if not ec_file.exists():
        infra_errors.append(f"{name}: exit_code.txt missing")
        continue
    if not meta.exists():
        infra_errors.append(f"{name}: metadata.txt missing")
        continue
    if not corpus.exists() or not any(corpus.iterdir()):
        infra_errors.append(f"{name}: working corpus is empty")
        continue

    ec = ec_file.read_text().strip()
    corpus_count = sum(1 for f in corpus.iterdir() if f.is_file())
    crashes_dir = harness_dir / "crashes"
    crash_count = sum(1 for f in crashes_dir.iterdir() if f.is_file()) if crashes_dir.exists() else 0

    psynced = "n/a"
    for line in meta.read_text().splitlines():
        if line.startswith("persistent_synced:"):
            psynced = line.split(":", 1)[1].strip()

    print(f"[OK] {name}: log={log.stat().st_size}B  exit_code={ec}  corpus={corpus_count}  crashes={crash_count}  persistent_synced={psynced}")

    if ec != "0":
        fuzzer_failures.append(f"{name}: exit_code={ec}")

if infra_errors:
    for e in infra_errors:
        print(f"[FAIL] {e}", file=sys.stderr)
    sys.exit(1)

if fuzzer_failures and not ALLOW_FAILURES:
    for e in fuzzer_failures:
        print(f"[FAIL] {e}", file=sys.stderr)
    sys.exit(1)
PY
'''
            }
        }

        stage('Firmware Image - RootFS') {
            when {
                expression { return params.RUN_EMBA_ROOTFS }
            }
            agent {
                docker {
                    image 'devsecops-agente:1.0'
                    reuseNode true
                    args '-u 101:103'
                }
            }
            steps {
                sh '''#!/usr/bin/env bash
set -euo pipefail

mkdir -p results/firmware
rm -rf build-rootfs

ROOTFS="${WORKSPACE}/build-rootfs/rootfs"
mkdir -p "$ROOTFS"

echo "=== Creating minimal Mosquitto rootfs for EMBA ==="

mkdir -p "$ROOTFS/usr/sbin"
mkdir -p "$ROOTFS/usr/bin"
mkdir -p "$ROOTFS/etc/mosquitto"
mkdir -p "$ROOTFS/etc/init.d"
mkdir -p "$ROOTFS/etc"
mkdir -p "$ROOTFS/var/log"
mkdir -p "$ROOTFS/var/lib/mosquitto"
mkdir -p "$ROOTFS/tmp"

test -x build/src/mosquitto
cp build/src/mosquitto "$ROOTFS/usr/sbin/mosquitto"

if [ -x build/client/mosquitto_pub ]; then
  cp build/client/mosquitto_pub "$ROOTFS/usr/bin/mosquitto_pub"
fi

if [ -x build/client/mosquitto_sub ]; then
  cp build/client/mosquitto_sub "$ROOTFS/usr/bin/mosquitto_sub"
fi

cat > "$ROOTFS/etc/os-release" <<'EOF'
NAME="Mosquitto DevSecOps Lab Firmware"
ID=mosquitto-devsecops-lab
VERSION_ID="2.0.18"
PRETTY_NAME="Mosquitto DevSecOps Lab Firmware 2.0.18"
EOF

cat > "$ROOTFS/etc/mosquitto/mosquitto.conf" <<'EOF'
pid_file /tmp/mosquitto.pid
persistence true
persistence_location /var/lib/mosquitto/
log_dest file /var/log/mosquitto.log
listener 1883
allow_anonymous true
EOF

cat > "$ROOTFS/etc/init.d/S50mosquitto" <<'EOF'
#!/bin/sh
case "$1" in
  start)
    /usr/sbin/mosquitto -c /etc/mosquitto/mosquitto.conf
    ;;
  stop)
    killall mosquitto || true
    ;;
  *)
    echo "Usage: $0 {start|stop}"
    exit 1
    ;;
esac
EOF

chmod +x "$ROOTFS/etc/init.d/S50mosquitto"

echo "=== Copying dynamic library dependencies ==="
ldd build/src/mosquitto | tee results/firmware/mosquitto-ldd.txt

python3 - <<'PY'
import os
import re
import shutil
import subprocess
from pathlib import Path

workspace = Path(os.environ["WORKSPACE"])
rootfs = workspace / "build-rootfs" / "rootfs"
binary = workspace / "build" / "src" / "mosquitto"

out = subprocess.check_output(["ldd", str(binary)], text=True)
paths = set()

for line in out.splitlines():
    for match in re.findall(r"(/[^\\s]+)", line):
        if Path(match).exists():
            paths.add(match)

for line in out.splitlines():
    stripped = line.strip()
    if stripped.startswith("/") and "=>" not in stripped:
        candidate = stripped.split()[0]
        if Path(candidate).exists():
            paths.add(candidate)

copied = []

for src in sorted(paths):
    src_path = Path(src)
    dst = rootfs / src_path.relative_to("/")
    dst.parent.mkdir(parents=True, exist_ok=True)

    try:
        shutil.copy2(src_path, dst)
        copied.append((src, str(dst.relative_to(rootfs))))
    except Exception as exc:
        print(f"WARNING: could not copy {src}: {exc}")

manifest = workspace / "results" / "firmware" / "rootfs-copied-libraries.txt"
manifest.write_text("\\n".join(f"{src} -> {dst}" for src, dst in copied) + "\\n", encoding="utf-8")
print(f"[OK] Copied {len(copied)} dynamic library dependencies")
PY

echo "=== Adding Debian package metadata when available ==="
mkdir -p "$ROOTFS/var/lib/dpkg"

if command -v dpkg-query >/dev/null 2>&1; then
  dpkg-query -W -f='Package: ${binary:Package}\\nVersion: ${Version}\\nArchitecture: ${Architecture}\\nStatus: install ok installed\\n\\n' \
    libc6 libssl3 libssl-dev openssl zlib1g libwebsockets17 2>/dev/null \
    > "$ROOTFS/var/lib/dpkg/status" || true
fi

if [ ! -s "$ROOTFS/var/lib/dpkg/status" ]; then
  cat > "$ROOTFS/var/lib/dpkg/status" <<'EOF'
Package: mosquitto-devsecops-lab
Version: 2.0.18
Architecture: amd64
Status: install ok installed
Description: Synthetic package metadata for Mosquitto DevSecOps lab firmware.
EOF
fi

echo "=== Recording firmware manifest ==="
find "$ROOTFS" -maxdepth 4 -type f | sort > results/firmware/rootfs-file-list.txt

tar -C "$ROOTFS" -czf results/firmware/mosquitto-rootfs.tar.gz .

test -s results/firmware/mosquitto-rootfs.tar.gz

echo "=== Firmware artifacts ==="
ls -lh results/firmware/mosquitto-rootfs.tar.gz
ls -lh results/firmware/mosquitto-ldd.txt
ls -lh results/firmware/rootfs-copied-libraries.txt || true
ls -lh results/firmware/rootfs-file-list.txt
'''
            }
        }

        stage('Firmware Analysis - EMBA') {
            agent any
            steps {
                sh '''#!/usr/bin/env bash
set -euo pipefail

mkdir -p results/emba
rm -rf results/emba/*

BUILD_ID_SAFE="${BUILD_NUMBER:-0}"
EMBA_WORK="/tmp/emba/${BUILD_ID_SAFE}"
EMBA_INPUT_DIR="${EMBA_WORK}/input"
EMBA_LOG_DIR="${EMBA_WORK}/logs"

rm -rf "$EMBA_WORK"
mkdir -p "$EMBA_INPUT_DIR"
mkdir -p "$EMBA_LOG_DIR"

if [ "${RUN_EMBA_ROOTFS:-false}" = "true" ] && [ -s "${WORKSPACE}/results/firmware/mosquitto-rootfs.tar.gz" ]; then
  echo "=== EMBA target: rootfs firmware archive ==="
  cp "${WORKSPACE}/results/firmware/mosquitto-rootfs.tar.gz" "${EMBA_INPUT_DIR}/mosquittoRootfs"
  EMBA_TARGET="${EMBA_INPUT_DIR}/mosquittoRootfs"
else
  echo "=== EMBA target: ELF binary fallback ==="
  test -x "${WORKSPACE}/build/src/mosquitto"
  cp "${WORKSPACE}/build/src/mosquitto" "${EMBA_INPUT_DIR}/mosquitto"
  EMBA_TARGET="${EMBA_INPUT_DIR}/mosquitto"
fi

echo "=== EMBA safe execution paths ==="
echo "WORKSPACE=${WORKSPACE}"
echo "EMBA_WORK=${EMBA_WORK}"
echo "EMBA_TARGET=${EMBA_TARGET}"
echo "EMBA_LOG_DIR=${EMBA_LOG_DIR}"

test -e "$EMBA_TARGET"

cd /opt/emba

set +e
sudo -n ./emba \
  -l "$EMBA_LOG_DIR" \
  -f "$EMBA_TARGET" \
  -p /opt/emba/scan-profiles/full-scan.emba \
  -y
EMBA_RC=$?
set -e

echo "$EMBA_RC" > "${WORKSPACE}/results/emba/emba-exit-code.txt"

echo "=== Copying EMBA results back to Jenkins workspace ==="
if [ -d "$EMBA_LOG_DIR" ]; then
  sudo -n chown -R "$(id -u):$(id -g)" "$EMBA_LOG_DIR" || true
  cp -a "$EMBA_LOG_DIR/." "${WORKSPACE}/results/emba/" || true
fi

echo "=== EMBA artifacts ==="
find "${WORKSPACE}/results/emba" -maxdepth 3 -type f | sort | sed -n '1,120p' || true

echo "=== Cleaning temporary EMBA workdir ==="
rm -rf "$EMBA_WORK" || true

exit 0
'''
            }
        }

        stage('Hardening') {
            agent {
                docker {
                    image 'devsecops-agente:1.0'
                    reuseNode true
                    args '-u 101:103'
                }
            }
            steps {
                sh '''#!/usr/bin/env bash
set -euo pipefail

mkdir -p results/hardening

echo "=== Verifying hardening of main build artifact ==="
test -x build/src/mosquitto

checksec \
  --file=build/src/mosquitto \
  --output=json \
  > results/hardening/checksec.json

test -s results/hardening/checksec.json

python3 - <<'PY'
import json
from pathlib import Path

path = Path("results/hardening/checksec.json")
data = json.loads(path.read_text(encoding="utf-8"))
print(f"[OK] JSON válido: {path}")
print(json.dumps(data, indent=2))
PY
'''
            }
        }

        stage('Persist Monitoring Inventories') {
            agent any
            steps {
                sh '''#!/usr/bin/env bash
set -euo pipefail

PROJECT="mosquitto"
BUILD_ID_SAFE="${BUILD_NUMBER:-manual}"
DEST="/opt/devsecops-lab/artifacts/${PROJECT}/${BUILD_ID_SAFE}"

mkdir -p "${DEST}/sca"
mkdir -p "${DEST}/emba/SBOM"
mkdir -p "${DEST}/metadata"

echo "=== Persisting monitoring inventories ==="
echo "DEST=${DEST}"

copy_if_exists() {
  src="$1"
  dst="$2"
  if [ -s "$src" ]; then
    cp "$src" "$dst"
    echo "[OK] $src -> $dst"
  else
    echo "[WARN] Missing: $src"
  fi
}

copy_if_exists results/sca/sbom-source.cyclonedx.json \
  "${DEST}/sca/sbom-source.cyclonedx.json"

copy_if_exists results/sca/vendor-manifest.cdx.json \
  "${DEST}/sca/vendor-manifest.cdx.json"

copy_if_exists results/sca/grype-source.json \
  "${DEST}/sca/grype-source.json"

copy_if_exists results/sca/grype-vendor-manifest.json \
  "${DEST}/sca/grype-vendor-manifest.json"

copy_if_exists results/sca/grype-db-status.json \
  "${DEST}/sca/grype-db-status.json"

EMBA_SBOM_SRC=""
for candidate in \
  "results/emba/SBOM/EMBA_cyclonedx_sbom.json" \
  "results/emba/SBOM/EMBA_cyclonedx_vex_sbom.json"
do
  if [ -s "$candidate" ]; then
    EMBA_SBOM_SRC="$candidate"
    break
  fi
done

if [ -n "$EMBA_SBOM_SRC" ]; then
  cp "$EMBA_SBOM_SRC" "${DEST}/emba/SBOM/EMBA_cyclonedx_sbom.json"
  echo "[OK] EMBA SBOM persisted from $EMBA_SBOM_SRC"
else
  echo "[WARN] No EMBA CycloneDX SBOM found"
fi

sha_or_null() {
  if [ -s "$1" ]; then sha256sum "$1" | awk '{print $1}'; else echo ""; fi
}

size_or_zero() {
  if [ -s "$1" ]; then stat -c '%s' "$1"; else echo 0; fi
}

cat > "${DEST}/metadata/build.json" <<EOF
{
  "project": "${PROJECT}",
  "jenkins_build_number": "${BUILD_ID_SAFE}",
  "jenkins_build_url": "${BUILD_URL:-}",
  "git_branch": "${BRANCH_NAME:-}",
  "git_commit": "${GIT_COMMIT:-}",
  "workspace": "${WORKSPACE:-}",
  "persisted_at_utc": "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
}
EOF

cat > "${DEST}/metadata/inventories.json" <<EOF
{
  "project": "${PROJECT}",
  "build_id": "${BUILD_ID_SAFE}",
  "inventories": [
    {
      "id": "source_sbom",
      "logical_name": "syft-source-sbom",
      "path": "${DEST}/sca/sbom-source.cyclonedx.json",
      "origin": "source_sbom",
      "source_type": "SYFT_SBOM",
      "scope": "source_or_build_inventory",
      "artifact_type": "SBOM",
      "detection_phase": "SCA_SOURCE_SBOM",
      "required": true,
      "sha256": "$(sha_or_null "${DEST}/sca/sbom-source.cyclonedx.json")",
      "size_bytes": $(size_or_zero "${DEST}/sca/sbom-source.cyclonedx.json")
    },
    {
      "id": "vendor_manifest",
      "logical_name": "curated-vendor-manifest",
      "path": "${DEST}/sca/vendor-manifest.cdx.json",
      "origin": "vendor_manifest",
      "source_type": "VENDOR_MANIFEST",
      "scope": "curated_dependency_inventory",
      "artifact_type": "SBOM",
      "detection_phase": "SCA_VENDOR_MANIFEST",
      "required": true,
      "sha256": "$(sha_or_null "${DEST}/sca/vendor-manifest.cdx.json")",
      "size_bytes": $(size_or_zero "${DEST}/sca/vendor-manifest.cdx.json")
    },
    {
      "id": "emba_sbom",
      "logical_name": "emba-rootfs-sbom",
      "path": "${DEST}/emba/SBOM/EMBA_cyclonedx_sbom.json",
      "origin": "emba_sbom",
      "source_type": "EMBA_SBOM",
      "scope": "runtime_rootfs_inventory",
      "artifact_type": "SBOM",
      "detection_phase": "SCA_FIRMWARE_SBOM",
      "required": false,
      "sha256": "$(sha_or_null "${DEST}/emba/SBOM/EMBA_cyclonedx_sbom.json")",
      "size_bytes": $(size_or_zero "${DEST}/emba/SBOM/EMBA_cyclonedx_sbom.json")
    }
  ]
}
EOF

echo "=== Validating persisted inventories ==="
python3 - <<PY
import json
from pathlib import Path

registry = json.loads(Path("${DEST}/metadata/inventories.json").read_text(encoding="utf-8"))

for inv in registry["inventories"]:
    path = Path(inv["path"])
    required = inv["required"]

    if not path.exists() or path.stat().st_size == 0:
        if required:
            raise SystemExit(f"Required inventory missing: {path}")
        print(f"[WARN] Optional inventory missing: {path}")
        continue

    data = json.loads(path.read_text(encoding="utf-8"))
    if data.get("bomFormat") != "CycloneDX":
        raise SystemExit(f"Not CycloneDX: {path}")

    print(f"[OK] {inv['id']} | components={len(data.get('components', []))} | {path}")
PY

echo "=== Persisted monitoring inputs ==="
find "${DEST}" -type f | sort
'''
            }
        }
    }

    post {
        always {
            node('') {
                archiveArtifacts artifacts: 'results/**', allowEmptyArchive: true
                echo "Artefactos: ${env.BUILD_URL}artifact/results/"
            }
        }

        success {
            echo 'Pipeline OK'
        }

        failure {
            echo 'Pipeline FALLIDO'
        }
    }
}
