pipeline {
    agent none

    options {
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '20'))
        skipDefaultCheckout(true)
    }

    parameters {
        booleanParam(
            name: 'RUN_COVERITY_MISRA',
            defaultValue: false,
            description: 'Ejecutar análisis MISRA C 2012 con Coverity. Recomendado solo bajo demanda por su alto volumen de hallazgos.'
        )
    }

    environment {
        RESULTS = 'results'
    }

    stages {
        stage('Checkout') {
            agent any
            steps {
                checkout scm

                sh '''#!/usr/bin/env bash
set -euo pipefail

rm -rf results build build-* build-coverity coverity-config .codeql-cache .cache .codeql-home .lab/fuzzing/findings || true

mkdir -p results/sast
mkdir -p results/compliance
mkdir -p results/sca
mkdir -p results/fuzzing
mkdir -p results/emba
mkdir -p results/hardening
mkdir -p results/build
'''
            }
        }

        stage('Build') {
            agent {
                docker {
                    image 'devsecops-agente:1.0'
                    reuseNode true
                    args '-u 101:103'
                }
            }
            steps {
                sh '''#!/usr/bin/env bash
set -euo pipefail

cmake -S . -B build \
  -DCMAKE_BUILD_TYPE=Release \
  -DCMAKE_C_COMPILER=clang \
  -DCMAKE_CXX_COMPILER=clang++ \
  -DCMAKE_EXPORT_COMPILE_COMMANDS=ON \
  -DDOCUMENTATION=OFF \
  -DCMAKE_C_FLAGS_RELEASE="-O2 -D_FORTIFY_SOURCE=2 -fstack-protector-strong -fPIE" \
  -DCMAKE_CXX_FLAGS_RELEASE="-O2 -D_FORTIFY_SOURCE=2 -fstack-protector-strong -fPIE" \
  -DCMAKE_EXE_LINKER_FLAGS="-pie -Wl,-z,relro,-z,now"

cmake --build build --clean-first -j"$(nproc)"

test -x build/src/mosquitto

cp build/src/mosquitto results/build/
'''
            }
        }

        stage('Secrets Scan') {
            agent {
                docker {
                    image 'devsecops-agente:1.0'
                    reuseNode true
                    args '-u 101:103'
                }
            }
            steps {
                sh '''#!/usr/bin/env bash
set -euo pipefail

TMP_SRC="$(mktemp -d)"
trap 'rm -rf "$TMP_SRC"' EXIT

tar \
  --exclude='./.git' \
  --exclude='./.github' \
  --exclude='./results' \
  --exclude='./build' \
  --exclude='./build-*' \
  --exclude='./build-coverity' \
  --exclude='./coverity-config' \
  --exclude='./.codeql-cache' \
  --exclude='./.cache' \
  --exclude='./.codeql-home' \
  --exclude='./.lab/fuzzing/findings' \
  -cf - . | tar -xf - -C "$TMP_SRC"

gitleaks detect \
  --source "$TMP_SRC" \
  --no-git \
  --report-format json \
  --report-path results/sast/gitleaks.json \
  --exit-code 0

test -s results/sast/gitleaks.json

if command -v jq >/dev/null 2>&1; then
  jq empty results/sast/gitleaks.json
fi
'''
            }
        }

        stage('SAST - CodeQL') {
            agent {
                docker {
                    image 'devsecops-agente:1.0'
                    reuseNode true
                    args '-u 101:103 -v /opt/devsecops-lab/codeql:/opt/codeql:ro'
                }
            }
            steps {
                sh '''#!/usr/bin/env bash
set -euo pipefail

export HOME="${WORKSPACE}/.codeql-home"
mkdir -p "${HOME}/.codeql"

rm -rf build-codeql build/codeql-db

cmake -S . -B build-codeql \
  -DCMAKE_BUILD_TYPE=Release \
  -DCMAKE_C_COMPILER=clang \
  -DCMAKE_CXX_COMPILER=clang++ \
  -DCMAKE_EXPORT_COMPILE_COMMANDS=ON \
  -DDOCUMENTATION=OFF \
  -DCMAKE_C_FLAGS_RELEASE="-O2 -D_FORTIFY_SOURCE=2 -fstack-protector-strong -fPIE" \
  -DCMAKE_CXX_FLAGS_RELEASE="-O2 -D_FORTIFY_SOURCE=2 -fstack-protector-strong -fPIE" \
  -DCMAKE_EXE_LINKER_FLAGS="-pie -Wl,-z,relro,-z,now"

/opt/codeql/codeql/codeql database create build/codeql-db \
  --language=cpp \
  --source-root=. \
  --command="cmake --build build-codeql --clean-first -j$(nproc)"

CPP_SUITE="$(find /opt/codeql/codeql/qlpacks -path '*/codeql/cpp-queries/*/codeql-suites/cpp-security-and-quality.qls' | sort | tail -1)"
test -n "$CPP_SUITE"

/opt/codeql/codeql/codeql database analyze build/codeql-db \
  "$CPP_SUITE" \
  --format=sarif-latest \
  --output=results/sast/codeql.sarif

test -s results/sast/codeql.sarif
'''
            }
        }

        stage('SAST - Coverity') {
            agent {
                docker {
                    image 'devsecops-agente:1.0'
                    reuseNode true
                    args '-u 101:103'
                }
            }
            steps {
                withCredentials([file(credentialsId: 'coverity-license', variable: 'COV_LICENSE')]) {
                    sh '''#!/usr/bin/env bash
set -euo pipefail

mkdir -p results/sast
mkdir -p results/compliance

echo "=== Coverity license precheck ==="
test -f "${COV_LICENSE}"
test -r "${COV_LICENSE}"

cp "${COV_LICENSE}" "${WORKSPACE}/coverity-license.dat"
chmod 600 "${WORKSPACE}/coverity-license.dat"

trap 'rm -f "${WORKSPACE}/coverity-license.dat"' EXIT

test -f "${WORKSPACE}/coverity-license.dat"
test -r "${WORKSPACE}/coverity-license.dat"

CERT_CFG=/opt/coverity/config/coding-standards/cert-c/cert-c-all.config
MISRA_CFG=/opt/coverity/config/coding-standards/misrac2012/misrac2012-all.config

test -f "$CERT_CFG"

if [ "${RUN_COVERITY_MISRA:-false}" = "true" ]; then
  test -f "$MISRA_CFG"
fi

mkdir -p "${WORKSPACE}/coverity-config"

rm -f "${WORKSPACE}/coverity-config/coverity_config.xml"
rm -rf build-coverity

echo "=== Coverity configure ==="
/opt/coverity/bin/cov-configure \
  --config "${WORKSPACE}/coverity-config/coverity_config.xml" \
  --template \
  --compiler clang \
  --comptype clangcc

echo "=== CMake configure for Coverity ==="
cmake -S . -B build-coverity \
  -DCMAKE_BUILD_TYPE=Release \
  -DCMAKE_C_COMPILER=clang \
  -DCMAKE_CXX_COMPILER=clang++ \
  -DCMAKE_EXPORT_COMPILE_COMMANDS=ON \
  -DDOCUMENTATION=OFF \
  -DCMAKE_C_FLAGS_RELEASE="-O2 -D_FORTIFY_SOURCE=2 -fstack-protector-strong -fPIE" \
  -DCMAKE_CXX_FLAGS_RELEASE="-O2 -D_FORTIFY_SOURCE=2 -fstack-protector-strong -fPIE" \
  -DCMAKE_EXE_LINKER_FLAGS="-pie -Wl,-z,relro,-z,now"

echo "=== Coverity build capture with complementary info ==="
/opt/coverity/bin/cov-build \
  --config "${WORKSPACE}/coverity-config/coverity_config.xml" \
  --dir build-coverity/cov-int-base \
  --emit-complementary-info \
  cmake --build build-coverity --clean-first -j"$(nproc)"

test -d build-coverity/cov-int-base

echo "=== Preparing independent Coverity intermediate directories ==="
rm -rf build-coverity/cov-int-standard
rm -rf build-coverity/cov-int-cert
rm -rf build-coverity/cov-int-misra

cp -a build-coverity/cov-int-base build-coverity/cov-int-standard
cp -a build-coverity/cov-int-base build-coverity/cov-int-cert

echo "=== Coverity standard analysis ==="
/opt/coverity/bin/cov-manage-emit \
  --dir build-coverity/cov-int-standard \
  reset-host-name

/opt/coverity/bin/cov-analyze \
  --security-file "${WORKSPACE}/coverity-license.dat" \
  --dir build-coverity/cov-int-standard \
  --all \
  2>&1 | tee results/sast/coverity-standard-analyze.log

/opt/coverity/bin/cov-format-errors \
  --security-file "${WORKSPACE}/coverity-license.dat" \
  --dir build-coverity/cov-int-standard \
  --json-output-v8 results/sast/coverity-standard.json

test -s results/sast/coverity-standard.json

# Alias de compatibilidad para consumidores que esperen el nombre anterior.
cp results/sast/coverity-standard.json results/sast/coverity.json

echo "=== Coverity CERT C compliance analysis ==="
/opt/coverity/bin/cov-manage-emit \
  --dir build-coverity/cov-int-cert \
  reset-host-name

/opt/coverity/bin/cov-analyze \
  --security-file "${WORKSPACE}/coverity-license.dat" \
  --dir build-coverity/cov-int-cert \
  --disable-default \
  --coding-standard-config "$CERT_CFG" \
  2>&1 | tee results/compliance/coverity-cert-analyze.log

/opt/coverity/bin/cov-format-errors \
  --security-file "${WORKSPACE}/coverity-license.dat" \
  --dir build-coverity/cov-int-cert \
  --json-output-v8 results/compliance/coverity-cert.json

test -s results/compliance/coverity-cert.json

if [ "${RUN_COVERITY_MISRA:-false}" = "true" ]; then
  echo "=== Coverity MISRA C 2012 compliance analysis ==="

  cp -a build-coverity/cov-int-base build-coverity/cov-int-misra

  /opt/coverity/bin/cov-manage-emit \
    --dir build-coverity/cov-int-misra \
    reset-host-name

  /opt/coverity/bin/cov-analyze \
    --security-file "${WORKSPACE}/coverity-license.dat" \
    --dir build-coverity/cov-int-misra \
    --disable-default \
    --coding-standard-config "$MISRA_CFG" \
    2>&1 | tee results/compliance/coverity-misra-analyze.log

  /opt/coverity/bin/cov-format-errors \
    --security-file "${WORKSPACE}/coverity-license.dat" \
    --dir build-coverity/cov-int-misra \
    --json-output-v8 results/compliance/coverity-misra.json

  test -s results/compliance/coverity-misra.json
else
  echo "Coverity MISRA skipped. Enable RUN_COVERITY_MISRA=true to run it."
fi

echo "=== Validating Coverity JSON outputs ==="
if command -v jq >/dev/null 2>&1; then
  jq empty results/sast/coverity-standard.json
  jq empty results/sast/coverity.json
  jq empty results/compliance/coverity-cert.json

  if [ "${RUN_COVERITY_MISRA:-false}" = "true" ]; then
    jq empty results/compliance/coverity-misra.json
  fi
else
  echo "jq not available in image; skipping JSON syntax validation."
fi

echo "=== Coverity artifacts ==="
ls -lh results/sast/coverity*.json || true
ls -lh results/sast/coverity*.log || true
ls -lh results/compliance/coverity*.json || true
ls -lh results/compliance/coverity*.log || true
'''
                }
            }
        }

        stage('SBOM') {
            agent {
                docker {
                    image 'devsecops-agente:1.0'
                    reuseNode true
                    args '-u 101:103'
                }
            }
            steps {
                sh '''#!/usr/bin/env bash
set -euo pipefail

mkdir -p "${WORKSPACE}/.cache"
mkdir -p results/sca

export XDG_CACHE_HOME="${WORKSPACE}/.cache"

echo "=== Generating source SBOM with Syft ==="
syft . \
  -o cyclonedx-json=results/sca/sbom-source.cyclonedx.json \
  --exclude './.git/**' \
  --exclude './.github/**' \
  --exclude './results/**' \
  --exclude './build/**' \
  --exclude './build-*/**' \
  --exclude './build-coverity/**' \
  --exclude './coverity-config/**' \
  --exclude './.codeql-cache/**' \
  --exclude './.cache/**' \
  --exclude './.codeql-home/**'

test -s results/sca/sbom-source.cyclonedx.json

if command -v jq >/dev/null 2>&1; then
  jq empty results/sca/sbom-source.cyclonedx.json
  jq -e '.bomFormat == "CycloneDX"' results/sca/sbom-source.cyclonedx.json
else
  echo "jq not available in image; skipping SBOM JSON validation."
fi
'''
            }
        }

        stage('SCA - Grype') {
            agent {
                docker {
                    image 'devsecops-agente:1.0'
                    reuseNode true
                    args '-u 101:103 -v /opt/devsecops-lab/vuln-dbs/grype:/home/jenkins/.cache/grype:ro'
                }
            }
            steps {
                sh '''#!/usr/bin/env bash
set -euo pipefail

mkdir -p results/sca

export GRYPE_DB_AUTO_UPDATE=false
export GRYPE_DB_CACHE_DIR=/home/jenkins/.cache/grype

echo "=== Precheck source SBOM ==="
test -s results/sca/sbom-source.cyclonedx.json

if command -v jq >/dev/null 2>&1; then
  jq empty results/sca/sbom-source.cyclonedx.json
  jq -e '.bomFormat == "CycloneDX"' results/sca/sbom-source.cyclonedx.json
fi

echo "=== Precheck curated vendor manifest ==="
test -s .lab/sca/vendor-manifest.cdx.json

if command -v jq >/dev/null 2>&1; then
  jq empty .lab/sca/vendor-manifest.cdx.json
  jq -e '.bomFormat == "CycloneDX"' .lab/sca/vendor-manifest.cdx.json
fi

if [ -f .lab/sca/validate_vendor_manifest.py ]; then
  python3 .lab/sca/validate_vendor_manifest.py
else
  echo "WARNING: .lab/sca/validate_vendor_manifest.py not found; skipping custom manifest validation."
fi

echo "=== Archiving curated vendor manifest used in this run ==="
cp .lab/sca/vendor-manifest.cdx.json results/sca/vendor-manifest.cdx.json

if [ -f .lab/sca/vendor-manifest.evidence.md ]; then
  cp .lab/sca/vendor-manifest.evidence.md results/sca/vendor-manifest.evidence.md
fi

echo "=== Grype scan: source SBOM ==="
grype sbom:results/sca/sbom-source.cyclonedx.json \
  --output json \
  --file results/sca/grype-source.json

echo "=== Grype scan: curated vendor manifest ==="
grype sbom:results/sca/vendor-manifest.cdx.json \
  --output json \
  --file results/sca/grype-vendor-manifest.json

test -s results/sca/grype-source.json
test -s results/sca/grype-vendor-manifest.json

if command -v jq >/dev/null 2>&1; then
  jq empty results/sca/grype-source.json
  jq empty results/sca/grype-vendor-manifest.json
fi

echo "=== SCA artifacts ==="
ls -lh results/sca/sbom-source.cyclonedx.json || true
ls -lh results/sca/vendor-manifest.cdx.json || true
ls -lh results/sca/vendor-manifest.evidence.md || true
ls -lh results/sca/grype-source.json || true
ls -lh results/sca/grype-vendor-manifest.json || true
'''
            }
        }

        stage('SCA - OWASP DC') {
            agent {
                docker {
                    image 'devsecops-agente:1.0'
                    reuseNode true
                    args '-u 101:103 -v /opt/devsecops-lab/vuln-dbs/owaspdc-data:/mnt/owaspdc-data:ro'
                }
            }
            steps {
                sh '''#!/usr/bin/env bash
set -euo pipefail

mkdir -p results/sca

rm -rf /tmp/owaspdc-data
mkdir -p /tmp/owaspdc-data
cp -r /mnt/owaspdc-data/. /tmp/owaspdc-data/

/opt/dependency-check/bin/dependency-check.sh \
  --project "mosquitto-devsecops-local" \
  --scan . \
  --exclude '.git/**' \
  --exclude '.github/**' \
  --exclude 'results/**' \
  --exclude 'build/**' \
  --exclude 'build-*/**' \
  --exclude 'build-coverity/**' \
  --exclude 'coverity-config/**' \
  --exclude '.codeql-cache/**' \
  --exclude '.cache/**' \
  --exclude '.codeql-home/**' \
  --format JSON \
  --format HTML \
  --out results/sca \
  --data /tmp/owaspdc-data \
  --noupdate \
  --enableExperimental \
  --disableAssembly || true

if [ -f results/sca/dependency-check-report.json ]; then
  cp results/sca/dependency-check-report.json results/sca/owaspdc.json
fi

test -s results/sca/owaspdc.json || echo "WARNING: OWASP Dependency-Check JSON report was not generated."

if [ -s results/sca/owaspdc.json ] && command -v jq >/dev/null 2>&1; then
  jq empty results/sca/owaspdc.json
fi
'''
            }
        }

        stage('Fuzzing - libFuzzer smoke') {
            agent {
                docker {
                    image 'devsecops-agente:1.0'
                    reuseNode true
                    args '-u 101:103'
                }
            }
            steps {
                sh '''#!/usr/bin/env bash
set -euo pipefail

rm -rf .lab/fuzzing/findings || true

cmake -S . -B build \
  -DCMAKE_C_COMPILER=clang \
  -DCMAKE_CXX_COMPILER=clang++ \
  -DCMAKE_EXPORT_COMPILE_COMMANDS=ON \
  -DDOCUMENTATION=OFF

cd .lab/fuzzing

python3 corpus/generate_corpus.py
bash ./build_libfuzzer.sh

CAMPAIGN_TIME=60 bash ./run_campaigns.sh libfuzzer || true

mkdir -p "${WORKSPACE}/results/fuzzing"

if [ -d "${WORKSPACE}/.lab/fuzzing/findings" ]; then
  cp -r "${WORKSPACE}/.lab/fuzzing/findings/." "${WORKSPACE}/results/fuzzing/" || true
fi

if [ -d "${WORKSPACE}/.lab/fuzzing/build" ]; then
  mkdir -p "${WORKSPACE}/results/fuzzing/build"
  cp -r "${WORKSPACE}/.lab/fuzzing/build/." "${WORKSPACE}/results/fuzzing/build/" || true
fi
'''
            }
        }

        stage('Firmware Analysis - EMBA') {
            agent any
            steps {
                sh '''#!/usr/bin/env bash
set -euo pipefail

mkdir -p results/emba
rm -rf results/emba/*

cd /opt/emba

sudo -n ./emba \
  -l "${WORKSPACE}/results/emba" \
  -f "${WORKSPACE}/build/src/mosquitto" \
  -p /opt/emba/scan-profiles/full-scan.emba \
  -y || true

sudo -n chown -R "$(id -u):$(id -g)" "${WORKSPACE}/results/emba" || true
'''
            }
        }

        stage('Hardening') {
            agent {
                docker {
                    image 'devsecops-agente:1.0'
                    reuseNode true
                    args '-u 101:103'
                }
            }
            steps {
                sh '''#!/usr/bin/env bash
set -euo pipefail

mkdir -p results/hardening

echo "=== Verifying hardening of main build artifact ==="
test -x build/src/mosquitto

checksec \
  --file=build/src/mosquitto \
  --output=json \
  > results/hardening/checksec.json

test -s results/hardening/checksec.json

if command -v jq >/dev/null 2>&1; then
  jq empty results/hardening/checksec.json
  jq '.' results/hardening/checksec.json
else
  echo "jq not available in image; skipping JSON syntax validation."
fi
'''
            }
        }
    }

    post {
        always {
            node('') {
                archiveArtifacts artifacts: 'results/**', allowEmptyArchive: true
                echo "Artefactos: ${env.BUILD_URL}artifact/results/"
            }
        }

        success {
            echo 'Pipeline OK'
        }

        failure {
            echo 'Pipeline FALLIDO'
        }
    }
}
