if data.get("bomFormat") != "CycloneDX":
    raise SystemExit(".lab/sca/vendor-manifest.cdx.json no es CycloneDX")

print("[OK] Vendor manifest JSON/CycloneDX válido")
PY

if [ -f .lab/sca/validate_vendor_manifest.py ]; then
  python3 .lab/sca/validate_vendor_manifest.py
else
