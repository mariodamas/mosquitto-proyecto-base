pipeline {
   agent none
   options {
       skipDefaultCheckout(true)
       disableConcurrentBuilds()
       timestamps()
   }
   environment {
       RESULTS = "results"
       EMBA_LOG_DIR = "/opt/devsecops-lab/emba-results/${JOB_NAME}/${BUILD_NUMBER}"
   }
   stages {
       stage('Checkout') {
           agent any
           steps {
               checkout scm
               sh 'mkdir -p "${RESULTS}"'
           }
       }
       stage('Build') {
           agent {
               docker {
                   image 'devsecops-agente:1.0'
                   args '''
                       -v /opt/devsecops-lab/vuln-dbs/grype:/home/jenkins/.cache/grype:ro
                       -v /opt/devsecops-lab/codeql:/opt/codeql:ro
                       -v /opt/devsecops-lab/vuln-dbs/owaspdc-data:/opt/owaspdc-data:ro
                   '''
                   reuseNode true
               }
           }
           steps {
               sh '''
                   set -e
                   mkdir -p build
                   cd build
                   cmake .. \
                     -DCMAKE_C_COMPILER=clang \
                     -DCMAKE_EXPORT_COMPILE_COMMANDS=ON \
                     -DDOCUMENTATION=OFF
                   make -j$(nproc)
                   ls -lh src/mosquitto || true
               '''
           }
       }
       stage('Secrets Scan') {
           agent {
               docker {
                   image 'devsecops-agente:1.0'
                   reuseNode true
               }
           }
           steps {
               sh '''
                   gitleaks detect --source . \
                       --report-format json \
                       --report-path ${RESULTS}/gitleaks.json \
                       --no-git || true
               '''
           }
           post {
               always {
                   archiveArtifacts artifacts: 'results/gitleaks.json', allowEmptyArchive: true
               }
           }
       }
       stage('SAST - CodeQL') {
           agent {
               docker {
                   image 'devsecops-agente:1.0'
                   args '-v /opt/devsecops-lab/codeql:/opt/codeql:ro'
                   reuseNode true
               }
           }
           steps {
               sh '''
                   set -e
                   mkdir -p "${WORKSPACE}/.codeql-cache"
                   rm -rf build-codeql build/codeql-db
                   cmake -S . -B build-codeql \
                     -DCMAKE_C_COMPILER=clang \
                     -DCMAKE_EXPORT_COMPILE_COMMANDS=ON \
                     -DDOCUMENTATION=OFF
                   /opt/codeql/codeql/codeql database create \
                     build/codeql-db \
                     --language=cpp \
                     --source-root=. \
                     --command="cmake --build build-codeql --clean-first -j$(nproc)" \
                     --common-caches "${WORKSPACE}/.codeql-cache" \
                     --overwrite
                   /opt/codeql/codeql/codeql database analyze \
                     build/codeql-db \
                     /opt/codeql/codeql/qlpacks/codeql/cpp-queries/*/codeql-suites/cpp-security-and-quality.qls \
                     --format sarif-latest \
                     --output ${RESULTS}/codeql.sarif \
                     --common-caches "${WORKSPACE}/.codeql-cache" || true
               '''
           }
           post {
               always {
                   archiveArtifacts artifacts: 'results/codeql.sarif', allowEmptyArchive: true
               }
           }
       }
       stage('SAST - Coverity') {
           agent {
               docker {
                   image 'devsecops-agente:1.0'
                   reuseNode true
               }
           }
           steps {
               withCredentials([file(credentialsId: 'coverity-license', variable: 'COV_LICENSE')]) {
                   sh '''
                       set -e
                       export LM_LICENSE_FILE="${COV_LICENSE}"
                       mkdir -p "${WORKSPACE}/coverity-config"
                       rm -f "${WORKSPACE}/coverity-config/coverity_config.xml"
                       rm -rf build-coverity
                       cov-configure \
                         --config "${WORKSPACE}/coverity-config/coverity_config.xml" \
                         --template \
                         --compiler clang \
                         --comptype clangcc
                       cmake -S . -B build-coverity \
                         -DCMAKE_C_COMPILER=clang \
                         -DCMAKE_EXPORT_COMPILE_COMMANDS=ON \
                         -DDOCUMENTATION=OFF
                       cov-build \
                         --config "${WORKSPACE}/coverity-config/coverity_config.xml" \
                         --dir build-coverity/cov-int \
                         cmake --build build-coverity --clean-first -j$(nproc)
                       cov-analyze --dir build-coverity/cov-int --all || true
                       cov-format-errors \
                         --dir build-coverity/cov-int \
                         --json-output-v8 ${RESULTS}/coverity.json || true
                   '''
               }
           }
           post {
               always {
                   archiveArtifacts artifacts: 'results/coverity.json', allowEmptyArchive: true
               }
           }
       }
       stage('SBOM') {
           agent {
               docker {
                   image 'devsecops-agente:1.0'
                   reuseNode true
               }
           }
           steps {
               sh '''
                   syft dir:. \
                       --output cyclonedx-json=${RESULTS}/sbom.cyclonedx.json
               '''
           }
           post {
               always {
                   archiveArtifacts artifacts: 'results/sbom.cyclonedx.json', allowEmptyArchive: true
               }
           }
       }
       stage('SCA - Grype') {
           agent {
               docker {
                   image 'devsecops-agente:1.0'
                   args '-v /opt/devsecops-lab/vuln-dbs/grype:/home/jenkins/.cache/grype:ro'
                   reuseNode true
               }
           }
           steps {
               sh '''
                   GRYPE_DB_CACHE_DIR=/home/jenkins/.cache/grype \
                   grype sbom:${RESULTS}/sbom.cyclonedx.json \
                       --output json \
                       --file ${RESULTS}/grype.json || true
               '''
           }
           post {
               always {
                   archiveArtifacts artifacts: 'results/grype.json', allowEmptyArchive: true
               }
           }
       }
       stage('SCA - OWASP DC') {
           agent {
               docker {
                   image 'devsecops-agente:1.0'
                   args '-v /opt/devsecops-lab/vuln-dbs/owaspdc-data:/opt/owaspdc-data:ro'
                   reuseNode true
               }
           }
           steps {
               sh '''
                   dependency-check.sh \
                       --scan . \
                       --format JSON \
                       --out ${RESULTS} \
                       --data /opt/owaspdc-data \
                       --noupdate \
                       --disableAssembly || true
                   if [ -f "${RESULTS}/dependency-check-report.json" ]; then
                       mv "${RESULTS}/dependency-check-report.json" "${RESULTS}/owaspdc.json"
                   fi
               '''
           }
           post {
               always {
                   archiveArtifacts artifacts: 'results/owaspdc.json', allowEmptyArchive: true
               }
           }
       }
       stage('Firmware Analysis - EMBA') {
           agent any
           steps {
               sh '''
                   mkdir -p "${EMBA_LOG_DIR}"
                   rm -rf "${EMBA_LOG_DIR:?}"/*
                   sudo -n /opt/emba/emba \
                       -l "${EMBA_LOG_DIR}" \
                       -f "${WORKSPACE}/build/src/mosquitto" \
                       -p /opt/emba/scan-profiles/default-scan.emba \
                       -y || true
               '''
           }
           post {
               always {
                   sh '''
                       mkdir -p "${RESULTS}/emba"
                       if [ -d "${EMBA_LOG_DIR}" ]; then
                           cp -r "${EMBA_LOG_DIR}/." "${RESULTS}/emba/" || true
                       fi
                   '''
                   archiveArtifacts artifacts: 'results/emba/**', allowEmptyArchive: true
               }
           }
       }
       stage('Hardening') {
           agent {
               docker {
                   image 'devsecops-agente:1.0'
                   reuseNode true
               }
           }
           steps {
               sh '''
                   checksec --file=build/src/mosquitto \
                       --output=json > ${RESULTS}/checksec.json || true
                   hardening-check build/src/mosquitto \
> ${RESULTS}/hardening-check.txt 2>&1 || true
               '''
           }
           post {
               always {
                   archiveArtifacts artifacts: 'results/checksec.json,results/hardening-check.txt',
                                    allowEmptyArchive: true
               }
           }
       }
   }
   post {
       success {
           echo "Pipeline OK"
       }
       failure {
           echo "Pipeline FALLIDO"
       }
       always {
           echo "Artefactos: ${BUILD_URL}artifact/results/"
       }
   }
}
