pipeline {
    agent none

    options {
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '20'))
        skipDefaultCheckout(true)
    }

    parameters {
        booleanParam(
            name: 'RUN_CODEQL',
            defaultValue: true,
            description: 'Ejecutar análisis SAST con CodeQL. Desactivar bajo demanda para acelerar el pipeline cuando el SAST de Coverity es suficiente.'
        )

        booleanParam(
            name: 'RUN_COVERITY_CERT',
            defaultValue: true,
            description: 'Ejecutar análisis CERT C con Coverity. Activado por defecto; desactivar bajo demanda para acelerar el pipeline.'
        )

        booleanParam(
            name: 'RUN_COVERITY_MISRA',
            defaultValue: false,
            description: 'Ejecutar análisis MISRA C 2012 con Coverity. Recomendado solo bajo demanda por su alto volumen de hallazgos.'
        )

        booleanParam(
            name: 'RUN_EMBA_ROOTFS',
            defaultValue: true,
            description: 'Construir un rootfs mínimo de laboratorio y ejecutar EMBA sobre ese artefacto en lugar de solo sobre el ELF.'
        )

        booleanParam(
            name: 'ALLOW_FUZZING_FAILURES',
            defaultValue: true,
            description: 'Si true, un harness con exit code distinto de cero no bloquea el pipeline; los artefactos se archivan igual. Los errores de infraestructura fallan siempre.'
        )

        string(
            name: 'FUZZING_CAMPAIGN_TIME',
            defaultValue: '300',
            description: 'Duración en segundos de cada campaña libFuzzer por harness. Usar 60 para smoke rápido, 300 para CI razonable y 900-1800 para campañas extendidas.'
        )
    }

    environment {
        RESULTS = 'results'

        PROJECT_NAME = 'mosquitto'
        PROJECT_LANGUAGE = 'C/C++'
        PROJECT_PLATFORM_TYPE = 'linux_embedded'

        EXECUTION_TYPE = 'ci_pipeline'
    }

    stages {
        stage('Checkout') {
            agent any

            steps {
                checkout scm

                sh '''#!/usr/bin/env bash
set -euo pipefail

rm -rf results build build-* build-coverity coverity-config .codeql-cache .cache .codeql-home .lab/fuzzing/findings || true

mkdir -p results/sast
mkdir -p results/compliance
mkdir -p results/sca
mkdir -p results/fuzzing
mkdir -p results/emba
mkdir -p results/firmware
mkdir -p results/hardening
mkdir -p results/build
'''
            }
        }

        stage('Build') {
            agent {
                docker {
                    image 'devsecops-agente:1.0'
                    reuseNode true
                    args '-u 101:103'
                }
            }

            steps {
                sh '''#!/usr/bin/env bash
set -euo pipefail

cmake -S . -B build \
  -DCMAKE_BUILD_TYPE=Release \
  -DCMAKE_C_COMPILER=clang \
  -DCMAKE_CXX_COMPILER=clang++ \
  -DCMAKE_EXPORT_COMPILE_COMMANDS=ON \
  -DDOCUMENTATION=OFF \
  -DCMAKE_C_FLAGS_RELEASE="-O2 -D_FORTIFY_SOURCE=2 -fstack-protector-strong -fPIE" \
  -DCMAKE_CXX_FLAGS_RELEASE="-O2 -D_FORTIFY_SOURCE=2 -fstack-protector-strong -fPIE" \
  -DCMAKE_EXE_LINKER_FLAGS="-pie -Wl,-z,relro,-z,now"

cmake --build build --clean-first -j"$(nproc)"

test -x build/src/mosquitto

cp build/src/mosquitto results/build/
'''
            }
        }

        stage('Secrets Scan') {
            agent {
                docker {
                    image 'devsecops-agente:1.0'
                    reuseNode true
                    args '-u 101:103'
                }
            }

            steps {
                sh '''#!/usr/bin/env bash
set -euo pipefail

TMP_SRC="$(mktemp -d)"
trap 'rm -rf "$TMP_SRC"' EXIT

tar \
  --exclude='./.git' \
  --exclude='./.github' \
  --exclude='./results' \
  --exclude='./build' \
  --exclude='./build-*' \
  --exclude='./build-coverity' \
  --exclude='./coverity-config' \
  --exclude='./.codeql-cache' \
  --exclude='./.cache' \
  --exclude='./.codeql-home' \
  --exclude='./.lab/fuzzing/findings' \
  -cf - . | tar -xf - -C "$TMP_SRC"

gitleaks detect \
  --source "$TMP_SRC" \
  --no-git \
  --report-format json \
  --report-path results/sast/gitleaks.json \
  --exit-code 0

test -s results/sast/gitleaks.json

python3 - <<'PY'
import json
from pathlib import Path

path = Path("results/sast/gitleaks.json")
json.loads(path.read_text(encoding="utf-8"))
print(f"[OK] JSON válido: {path}")
PY
'''
            }
        }

        stage('SAST - CodeQL') {
            when {
                expression { return params.RUN_CODEQL }
            }

            agent {
                docker {
                    image 'devsecops-agente:1.0'
                    reuseNode true
                    args '-u 101:103 -v /opt/devsecops-lab/codeql:/opt/codeql:ro'
                }
            }

            steps {
                sh '''#!/usr/bin/env bash
set -euo pipefail

export HOME="${WORKSPACE}/.codeql-home"
mkdir -p "${HOME}/.codeql"

rm -rf build-codeql build/codeql-db

cmake -S . -B build-codeql \
  -DCMAKE_BUILD_TYPE=Release \
  -DCMAKE_C_COMPILER=clang \
  -DCMAKE_CXX_COMPILER=clang++ \
  -DCMAKE_EXPORT_COMPILE_COMMANDS=ON \
  -DDOCUMENTATION=OFF \
  -DCMAKE_C_FLAGS_RELEASE="-O2 -D_FORTIFY_SOURCE=2 -fstack-protector-strong -fPIE" \
  -DCMAKE_CXX_FLAGS_RELEASE="-O2 -D_FORTIFY_SOURCE=2 -fstack-protector-strong -fPIE" \
  -DCMAKE_EXE_LINKER_FLAGS="-pie -Wl,-z,relro,-z,now"

/opt/codeql/codeql/codeql database create build/codeql-db \
  --language=cpp \
  --source-root=. \
  --command="cmake --build build-codeql --clean-first -j$(nproc)"

CPP_SUITE="$(find /opt/codeql/codeql/qlpacks -path '*/codeql/cpp-queries/*/codeql-suites/cpp-security-and-quality.qls' | sort | tail -1)"
test -n "$CPP_SUITE"

/opt/codeql/codeql/codeql database analyze build/codeql-db \
  "$CPP_SUITE" \
  --format=sarif-latest \
  --output=results/sast/codeql.sarif

test -s results/sast/codeql.sarif

python3 - <<'PY'
import json
from pathlib import Path

path = Path("results/sast/codeql.sarif")
json.loads(path.read_text(encoding="utf-8"))
print(f"[OK] JSON/SARIF válido: {path}")
PY
'''
            }
        }

        stage('SAST - Coverity') {
            agent {
                docker {
                    image 'devsecops-agente:1.0'
                    reuseNode true
                    args '-u 101:103'
                }
            }

            steps {
                withCredentials([file(credentialsId: 'coverity-license', variable: 'COV_LICENSE')]) {
                    sh '''#!/usr/bin/env bash
set -euo pipefail

mkdir -p results/sast
mkdir -p results/compliance

echo "=== Coverity license precheck ==="
test -f "${COV_LICENSE}"
test -r "${COV_LICENSE}"

cp "${COV_LICENSE}" "${WORKSPACE}/coverity-license.dat"
chmod 600 "${WORKSPACE}/coverity-license.dat"

trap 'rm -f "${WORKSPACE}/coverity-license.dat"' EXIT

CERT_CFG=/opt/coverity/config/coding-standards/cert-c/cert-c-all.config
MISRA_CFG=/opt/coverity/config/coding-standards/misrac2012/misrac2012-all.config

if [ "${RUN_COVERITY_CERT:-true}" = "true" ]; then
  test -f "$CERT_CFG"
fi

if [ "${RUN_COVERITY_MISRA:-false}" = "true" ]; then
  test -f "$MISRA_CFG"
fi

mkdir -p "${WORKSPACE}/coverity-config"

rm -f "${WORKSPACE}/coverity-config/coverity_config.xml"
rm -rf build-coverity

echo "=== Coverity configure ==="
/opt/coverity/bin/cov-configure \
  --config "${WORKSPACE}/coverity-config/coverity_config.xml" \
  --template \
  --compiler clang \
  --comptype clangcc

echo "=== CMake configure for Coverity ==="
cmake -S . -B build-coverity \
  -DCMAKE_BUILD_TYPE=Release \
  -DCMAKE_C_COMPILER=clang \
  -DCMAKE_CXX_COMPILER=clang++ \
  -DCMAKE_EXPORT_COMPILE_COMMANDS=ON \
  -DDOCUMENTATION=OFF \
  -DCMAKE_C_FLAGS_RELEASE="-O2 -D_FORTIFY_SOURCE=2 -fstack-protector-strong -fPIE" \
  -DCMAKE_CXX_FLAGS_RELEASE="-O2 -D_FORTIFY_SOURCE=2 -fstack-protector-strong -fPIE" \
  -DCMAKE_EXE_LINKER_FLAGS="-pie -Wl,-z,relro,-z,now"

echo "=== Coverity build capture with complementary info ==="
/opt/coverity/bin/cov-build \
  --config "${WORKSPACE}/coverity-config/coverity_config.xml" \
  --dir build-coverity/cov-int-base \
  --emit-complementary-info \
  cmake --build build-coverity --clean-first -j"$(nproc)"

test -d build-coverity/cov-int-base

echo "=== Preparing independent Coverity intermediate directories ==="
rm -rf build-coverity/cov-int-standard
rm -rf build-coverity/cov-int-cert
rm -rf build-coverity/cov-int-misra

cp -a build-coverity/cov-int-base build-coverity/cov-int-standard

if [ "${RUN_COVERITY_CERT:-true}" = "true" ]; then
  cp -a build-coverity/cov-int-base build-coverity/cov-int-cert
fi

echo "=== Coverity standard analysis ==="
/opt/coverity/bin/cov-manage-emit \
  --dir build-coverity/cov-int-standard \
  reset-host-name

/opt/coverity/bin/cov-analyze \
  --security-file "${WORKSPACE}/coverity-license.dat" \
  --dir build-coverity/cov-int-standard \
  --all \
  2>&1 | tee results/sast/coverity-standard-analyze.log

/opt/coverity/bin/cov-format-errors \
  --security-file "${WORKSPACE}/coverity-license.dat" \
  --dir build-coverity/cov-int-standard \
  --json-output-v8 results/sast/coverity-standard.json

test -s results/sast/coverity-standard.json

cp results/sast/coverity-standard.json results/sast/coverity.json

if [ "${RUN_COVERITY_CERT:-true}" = "true" ]; then
  echo "=== Coverity CERT C compliance analysis ==="

  /opt/coverity/bin/cov-manage-emit \
    --dir build-coverity/cov-int-cert \
    reset-host-name

  /opt/coverity/bin/cov-analyze \
    --security-file "${WORKSPACE}/coverity-license.dat" \
    --dir build-coverity/cov-int-cert \
    --disable-default \
    --coding-standard-config "$CERT_CFG" \
    2>&1 | tee results/compliance/coverity-cert-analyze.log

  /opt/coverity/bin/cov-format-errors \
    --security-file "${WORKSPACE}/coverity-license.dat" \
    --dir build-coverity/cov-int-cert \
    --json-output-v8 results/compliance/coverity-cert.json

  test -s results/compliance/coverity-cert.json
else
  echo "Coverity CERT C skipped. Enable RUN_COVERITY_CERT=true to run it."
fi

if [ "${RUN_COVERITY_MISRA:-false}" = "true" ]; then
  echo "=== Coverity MISRA C 2012 compliance analysis ==="

  cp -a build-coverity/cov-int-base build-coverity/cov-int-misra

  /opt/coverity/bin/cov-manage-emit \
    --dir build-coverity/cov-int-misra \
    reset-host-name

  /opt/coverity/bin/cov-analyze \
    --security-file "${WORKSPACE}/coverity-license.dat" \
    --dir build-coverity/cov-int-misra \
    --disable-default \
    --coding-standard-config "$MISRA_CFG" \
    2>&1 | tee results/compliance/coverity-misra-analyze.log

  /opt/coverity/bin/cov-format-errors \
    --security-file "${WORKSPACE}/coverity-license.dat" \
    --dir build-coverity/cov-int-misra \
    --json-output-v8 results/compliance/coverity-misra.json

  test -s results/compliance/coverity-misra.json
else
  echo "Coverity MISRA skipped. Enable RUN_COVERITY_MISRA=true to run it."
fi

echo "=== Validating Coverity JSON outputs with Python ==="
python3 - <<'PY'
import json
from pathlib import Path

paths = [
    Path("results/sast/coverity-standard.json"),
    Path("results/sast/coverity.json"),
]

for optional in [
    Path("results/compliance/coverity-cert.json"),
    Path("results/compliance/coverity-misra.json"),
]:
    if optional.exists():
        paths.append(optional)

for path in paths:
    json.loads(path.read_text(encoding="utf-8"))
    print(f"[OK] JSON válido: {path}")
PY

echo "=== Coverity artifacts ==="
ls -lh results/sast/coverity*.json || true
ls -lh results/sast/coverity*.log || true
ls -lh results/compliance/coverity*.json || true
ls -lh results/compliance/coverity*.log || true
'''
                }
            }
        }

        stage('SBOM') {
            agent {
                docker {
                    image 'devsecops-agente:1.0'
                    reuseNode true
                    args '-u 101:103'
                }
            }

            steps {
                sh '''#!/usr/bin/env bash
set -euo pipefail

mkdir -p "${WORKSPACE}/.cache"
mkdir -p results/sca

export XDG_CACHE_HOME="${WORKSPACE}/.cache"

echo "=== Generating source SBOM with Syft ==="
syft . \
  -o cyclonedx-json=results/sca/sbom-source.cyclonedx.json \
  --exclude './.git/**' \
  --exclude './.github/**' \
  --exclude './results/**' \
  --exclude './build/**' \
  --exclude './build-*/**' \
  --exclude './build-coverity/**' \
  --exclude './coverity-config/**' \
  --exclude './.codeql-cache/**' \
  --exclude './.cache/**' \
  --exclude './.codeql-home/**'

test -s results/sca/sbom-source.cyclonedx.json

python3 - <<'PY'
import json
from pathlib import Path

path = Path("results/sca/sbom-source.cyclonedx.json")
data = json.loads(path.read_text(encoding="utf-8"))

if data.get("bomFormat") != "CycloneDX":
    raise SystemExit("SBOM no es CycloneDX")

print(f"[OK] SBOM válido: {path}")
print(f"[INFO] Componentes SBOM fuente: {len(data.get('components', []))}")
PY
'''
            }
        }

        stage('SCA - Grype') {
            agent {
                docker {
                    image 'devsecops-agente:1.0'
                    reuseNode true
                    args '-u 101:103 -v /opt/devsecops-lab/vuln-dbs/grype:/home/jenkins/.cache/grype:ro -e GRYPE_DB_MAX_ALLOWED_BUILT_AGE=720h'
                }
            }

            steps {
                sh '''#!/usr/bin/env bash
set -euo pipefail

mkdir -p results/sca

export GRYPE_DB_AUTO_UPDATE=false
export GRYPE_DB_CACHE_DIR=/home/jenkins/.cache/grype
export GRYPE_DB_MAX_ALLOWED_BUILT_AGE=720h

echo "=== Grype DB status ==="
grype db status -o json | tee results/sca/grype-db-status.json

python3 - <<'PY'
import json
from pathlib import Path

path = Path("results/sca/grype-db-status.json")
json.loads(path.read_text(encoding="utf-8"))
print(f"[OK] Grype DB status JSON válido: {path}")
PY

echo "=== Precheck source SBOM ==="
test -s results/sca/sbom-source.cyclonedx.json

python3 - <<'PY'
import json
from pathlib import Path

path = Path("results/sca/sbom-source.cyclonedx.json")
data = json.loads(path.read_text(encoding="utf-8"))

if data.get("bomFormat") != "CycloneDX":
    raise SystemExit("results/sca/sbom-source.cyclonedx.json no es CycloneDX")

print("[OK] Source SBOM JSON/CycloneDX válido")
PY

echo "=== Precheck curated vendor manifest ==="
test -s .lab/sca/vendor-manifest.cdx.json

python3 - <<'PY'
import json
from pathlib import Path

path = Path(".lab/sca/vendor-manifest.cdx.json")
data = json.loads(path.read_text(encoding="utf-8"))

if data.get("bomFormat") != "CycloneDX":
    raise SystemExit(".lab/sca/vendor-manifest.cdx.json no es CycloneDX")

print("[OK] Vendor manifest JSON/CycloneDX válido")
PY

if [ -f .lab/sca/validate_vendor_manifest.py ]; then
  python3 .lab/sca/validate_vendor_manifest.py
else
  echo "WARNING: .lab/sca/validate_vendor_manifest.py not found; skipping custom manifest validation."
fi

echo "=== Archiving curated vendor manifest used in this run ==="
cp .lab/sca/vendor-manifest.cdx.json results/sca/vendor-manifest.cdx.json

if [ -f .lab/sca/vendor-manifest.evidence.md ]; then
  cp .lab/sca/vendor-manifest.evidence.md results/sca/vendor-manifest.evidence.md
fi

echo "=== Grype scan: source SBOM ==="
grype sbom:results/sca/sbom-source.cyclonedx.json \
  --output json \
  --file results/sca/grype-source.json

echo "=== Grype scan: curated vendor manifest ==="
grype sbom:results/sca/vendor-manifest.cdx.json \
  --output json \
  --file results/sca/grype-vendor-manifest.json

test -s results/sca/grype-source.json
test -s results/sca/grype-vendor-manifest.json

python3 - <<'PY'
import json
from pathlib import Path

for path in [
    Path("results/sca/grype-source.json"),
    Path("results/sca/grype-vendor-manifest.json"),
]:
    data = json.loads(path.read_text(encoding="utf-8"))
    print(f"[OK] Grype JSON válido: {path} | matches={len(data.get('matches', []))}")
PY

echo "=== SCA artifacts ==="
ls -lh results/sca/sbom-source.cyclonedx.json || true
ls -lh results/sca/vendor-manifest.cdx.json || true
ls -lh results/sca/vendor-manifest.evidence.md || true
ls -lh results/sca/grype-source.json || true
ls -lh results/sca/grype-vendor-manifest.json || true
ls -lh results/sca/grype-db-status.json || true
'''
            }
        }

        stage('SCA - OWASP DC') {
            agent {
                docker {
                    image 'devsecops-agente:1.0'
                    reuseNode true
                    args '-u 101:103 -v /opt/devsecops-lab/vuln-dbs/owaspdc-data:/mnt/owaspdc-data:ro'
                }
            }

            steps {
                sh '''#!/usr/bin/env bash
set -euo pipefail

mkdir -p results/sca

rm -rf /tmp/owaspdc-data
mkdir -p /tmp/owaspdc-data
cp -r /mnt/owaspdc-data/. /tmp/owaspdc-data/

/opt/dependency-check/bin/dependency-check.sh \
  --project "mosquitto-devsecops-local" \
  --scan . \
  --exclude '.git/**' \
  --exclude '.github/**' \
  --exclude 'results/**' \
  --exclude 'build/**' \
  --exclude 'build-*/**' \
  --exclude 'build-coverity/**' \
  --exclude 'coverity-config/**' \
  --exclude '.codeql-cache/**' \
  --exclude '.cache/**' \
  --exclude '.codeql-home/**' \
  --format JSON \
  --format HTML \
  --out results/sca \
  --data /tmp/owaspdc-data \
  --noupdate \
  --enableExperimental \
  --disableAssembly || true

if [ -f results/sca/dependency-check-report.json ]; then
  cp results/sca/dependency-check-report.json results/sca/owaspdc.json
fi

test -s results/sca/owaspdc.json || echo "WARNING: OWASP Dependency-Check JSON report was not generated."

if [ -s results/sca/owaspdc.json ]; then
  python3 - <<'PY'
import json
from pathlib import Path

path = Path("results/sca/owaspdc.json")
json.loads(path.read_text(encoding="utf-8"))
print(f"[OK] JSON válido: {path}")
PY
fi
'''
            }
        }

        stage('Fuzzing - libFuzzer smoke') {
            agent {
                docker {
                    image 'devsecops-agente:1.0'
                    reuseNode true
                    args '-u 101:103 -v /opt/devsecops-lab/fuzzing-corpus:/opt/devsecops-lab/fuzzing-corpus:rw'
                }
            }

            steps {
                sh '''#!/usr/bin/env bash
set -euo pipefail

echo "=== Fuzzing configuration ==="
echo "ALLOW_FUZZING_FAILURES=${ALLOW_FUZZING_FAILURES}"
echo "FUZZING_CAMPAIGN_TIME=${FUZZING_CAMPAIGN_TIME}"

if ! [[ "${FUZZING_CAMPAIGN_TIME}" =~ ^[0-9]+$ ]]; then
  echo "ERROR: FUZZING_CAMPAIGN_TIME must be a positive integer number of seconds"
  exit 1
fi

if [ "${FUZZING_CAMPAIGN_TIME}" -lt 1 ]; then
  echo "ERROR: FUZZING_CAMPAIGN_TIME must be greater than 0"
  exit 1
fi

rm -rf .lab/fuzzing/findings

cmake -S . -B build \
  -DCMAKE_C_COMPILER=clang \
  -DCMAKE_CXX_COMPILER=clang++ \
  -DCMAKE_EXPORT_COMPILE_COMMANDS=ON \
  -DDOCUMENTATION=OFF

cd .lab/fuzzing

python3 corpus/generate_corpus.py
bash ./build_libfuzzer.sh

FUZZING_PERSISTENT_CORPUS_DIR=/opt/devsecops-lab/fuzzing-corpus/mosquitto \
ALLOW_FUZZING_FAILURES="${ALLOW_FUZZING_FAILURES}" \
CAMPAIGN_TIME="${FUZZING_CAMPAIGN_TIME}" \
bash ./run_campaigns.sh libfuzzer

mkdir -p "${WORKSPACE}/results/fuzzing"

if [ -d "${WORKSPACE}/.lab/fuzzing/findings" ]; then
  cp -r "${WORKSPACE}/.lab/fuzzing/findings/." "${WORKSPACE}/results/fuzzing/"
fi

if [ -d "${WORKSPACE}/.lab/fuzzing/build" ]; then
  mkdir -p "${WORKSPACE}/results/fuzzing/build"
  cp -r "${WORKSPACE}/.lab/fuzzing/build/." "${WORKSPACE}/results/fuzzing/build/"
fi

echo "=== Validating fuzzing artefacts ==="
python3 - <<'PY'
import os
import sys
from pathlib import Path

ALLOW_FAILURES = os.environ.get("ALLOW_FUZZING_FAILURES", "true").strip().lower() == "true"

findings = Path("results/fuzzing/libfuzzer")
if not findings.exists():
    print("[WARN] No libfuzzer findings directory — harnesses may have been skipped")
    sys.exit(0)

infra_errors = []
fuzzer_failures = []

for harness_dir in sorted(findings.iterdir()):
    if not harness_dir.is_dir():
        continue

    name    = harness_dir.name
    log     = harness_dir / "run.log"
    ec_file = harness_dir / "exit_code.txt"
    meta    = harness_dir / "metadata.txt"
    corpus  = harness_dir / "corpus"

    if not log.exists():
        infra_errors.append(f"{name}: run.log missing")
        continue
    if log.stat().st_size == 0:
        infra_errors.append(f"{name}: run.log is empty")
        continue
    if not ec_file.exists():
        infra_errors.append(f"{name}: exit_code.txt missing")
        continue
    if not meta.exists():
        infra_errors.append(f"{name}: metadata.txt missing")
        continue
    if not corpus.exists() or not any(corpus.iterdir()):
        infra_errors.append(f"{name}: working corpus is empty")
        continue

    ec = ec_file.read_text().strip()
    corpus_count = sum(1 for f in corpus.iterdir() if f.is_file())
    crashes_dir = harness_dir / "crashes"
    crash_count = sum(1 for f in crashes_dir.iterdir() if f.is_file()) if crashes_dir.exists() else 0

    psynced = "n/a"
    for line in meta.read_text().splitlines():
        if line.startswith("persistent_synced:"):
            psynced = line.split(":", 1)[1].strip()

    print(f"[OK] {name}: log={log.stat().st_size}B  exit_code={ec}  corpus={corpus_count}  crashes={crash_count}  persistent_synced={psynced}")

    if ec != "0":
        fuzzer_failures.append(f"{name}: exit_code={ec}")

if infra_errors:
    for e in infra_errors:
        print(f"[FAIL] {e}", file=sys.stderr)
    sys.exit(1)

if fuzzer_failures and not ALLOW_FAILURES:
    for e in fuzzer_failures:
        print(f"[FAIL] {e}", file=sys.stderr)
    sys.exit(1)
PY
'''
            }
        }

        stage('Firmware Image - RootFS') {
            when {
                expression { return params.RUN_EMBA_ROOTFS }
            }

            agent {
                docker {
                    image 'devsecops-agente:1.0'
                    reuseNode true
                    args '-u 101:103'
                }
            }

            steps {
                sh '''#!/usr/bin/env bash
set -euo pipefail

mkdir -p results/firmware
rm -rf build-rootfs

ROOTFS="${WORKSPACE}/build-rootfs/rootfs"
mkdir -p "$ROOTFS"

echo "=== Creating minimal Mosquitto rootfs for EMBA ==="

mkdir -p "$ROOTFS/usr/sbin"
mkdir -p "$ROOTFS/usr/bin"
mkdir -p "$ROOTFS/etc/mosquitto"
mkdir -p "$ROOTFS/etc/init.d"
mkdir -p "$ROOTFS/etc"
mkdir -p "$ROOTFS/var/log"
mkdir -p "$ROOTFS/var/lib/mosquitto"
mkdir -p "$ROOTFS/tmp"

test -x build/src/mosquitto
cp build/src/mosquitto "$ROOTFS/usr/sbin/mosquitto"

if [ -x build/client/mosquitto_pub ]; then
  cp build/client/mosquitto_pub "$ROOTFS/usr/bin/mosquitto_pub"
fi

if [ -x build/client/mosquitto_sub ]; then
  cp build/client/mosquitto_sub "$ROOTFS/usr/bin/mosquitto_sub"
fi

cat > "$ROOTFS/etc/os-release" <<'EOF'
NAME="Mosquitto DevSecOps Lab Firmware"
ID=mosquitto-devsecops-lab
VERSION_ID="2.0.18"
PRETTY_NAME="Mosquitto DevSecOps Lab Firmware 2.0.18"
EOF

cat > "$ROOTFS/etc/mosquitto/mosquitto.conf" <<'EOF'
pid_file /tmp/mosquitto.pid
persistence true
persistence_location /var/lib/mosquitto/
log_dest file /var/log/mosquitto.log
listener 1883
allow_anonymous true
EOF

cat > "$ROOTFS/etc/init.d/S50mosquitto" <<'EOF'
#!/bin/sh
case "$1" in
  start)
    /usr/sbin/mosquitto -c /etc/mosquitto/mosquitto.conf
    ;;
  stop)
    killall mosquitto || true
    ;;
  *)
    echo "Usage: $0 {start|stop}"
    exit 1
    ;;
esac
EOF

chmod +x "$ROOTFS/etc/init.d/S50mosquitto"

echo "=== Copying dynamic library dependencies ==="
ldd build/src/mosquitto | tee results/firmware/mosquitto-ldd.txt

python3 - <<'PY'
import os
import re
import shutil
import subprocess
from pathlib import Path

workspace = Path(os.environ["WORKSPACE"])
rootfs = workspace / "build-rootfs" / "rootfs"
binary = workspace / "build" / "src" / "mosquitto"

out = subprocess.check_output(["ldd", str(binary)], text=True)
paths = set()

for line in out.splitlines():
    for match in re.findall(r"(/[^\\s]+)", line):
        if Path(match).exists():
            paths.add(match)

for line in out.splitlines():
    stripped = line.strip()
    if stripped.startswith("/") and "=>" not in stripped:
        candidate = stripped.split()[0]
        if Path(candidate).exists():
            paths.add(candidate)

copied = []

for src in sorted(paths):
    src_path = Path(src)
    dst = rootfs / src_path.relative_to("/")
    dst.parent.mkdir(parents=True, exist_ok=True)

    try:
        shutil.copy2(src_path, dst)
        copied.append((src, str(dst.relative_to(rootfs))))
    except Exception as exc:
        print(f"WARNING: could not copy {src}: {exc}")

manifest = workspace / "results" / "firmware" / "rootfs-copied-libraries.txt"
manifest.write_text("\\n".join(f"{src} -> {dst}" for src, dst in copied) + "\\n", encoding="utf-8")
print(f"[OK] Copied {len(copied)} dynamic library dependencies")
PY

echo "=== Adding Debian package metadata when available ==="
mkdir -p "$ROOTFS/var/lib/dpkg"

if command -v dpkg-query >/dev/null 2>&1; then
  dpkg-query -W -f='Package: ${binary:Package}\\nVersion: ${Version}\\nArchitecture: ${Architecture}\\nStatus: install ok installed\\n\\n' \
    libc6 libssl3 libssl-dev openssl zlib1g libwebsockets17 2>/dev/null \
    > "$ROOTFS/var/lib/dpkg/status" || true
fi

if [ ! -s "$ROOTFS/var/lib/dpkg/status" ]; then
  cat > "$ROOTFS/var/lib/dpkg/status" <<'EOF'
Package: mosquitto-devsecops-lab
Version: 2.0.18
Architecture: amd64
Status: install ok installed
Description: Synthetic package metadata for Mosquitto DevSecOps lab firmware.
EOF
fi

echo "=== Recording firmware manifest ==="
find "$ROOTFS" -maxdepth 4 -type f | sort > results/firmware/rootfs-file-list.txt

tar -C "$ROOTFS" -czf results/firmware/mosquitto-rootfs.tar.gz .

test -s results/firmware/mosquitto-rootfs.tar.gz

echo "=== Firmware artifacts ==="
ls -lh results/firmware/mosquitto-rootfs.tar.gz
ls -lh results/firmware/mosquitto-ldd.txt
ls -lh results/firmware/rootfs-copied-libraries.txt || true
ls -lh results/firmware/rootfs-file-list.txt
'''
            }
        }

        stage('Firmware Analysis - EMBA') {
            agent any

            steps {
                sh '''#!/usr/bin/env bash
set -euo pipefail

mkdir -p results/emba
rm -rf results/emba/*

BUILD_ID_SAFE="${BUILD_NUMBER:-0}"
EMBA_WORK="/tmp/emba/${BUILD_ID_SAFE}"
EMBA_INPUT_DIR="${EMBA_WORK}/input"
EMBA_LOG_DIR="${EMBA_WORK}/logs"

rm -rf "$EMBA_WORK"
mkdir -p "$EMBA_INPUT_DIR"
mkdir -p "$EMBA_LOG_DIR"

if [ "${RUN_EMBA_ROOTFS:-false}" = "true" ] && [ -s "${WORKSPACE}/results/firmware/mosquitto-rootfs.tar.gz" ]; then
  echo "=== EMBA target: rootfs firmware archive ==="
  cp "${WORKSPACE}/results/firmware/mosquitto-rootfs.tar.gz" "${EMBA_INPUT_DIR}/mosquittoRootfs"
  EMBA_TARGET="${EMBA_INPUT_DIR}/mosquittoRootfs"
else
  echo "=== EMBA target: ELF binary fallback ==="
  test -x "${WORKSPACE}/build/src/mosquitto"
  cp "${WORKSPACE}/build/src/mosquitto" "${EMBA_INPUT_DIR}/mosquitto"
  EMBA_TARGET="${EMBA_INPUT_DIR}/mosquitto"
fi

echo "=== EMBA safe execution paths ==="
echo "WORKSPACE=${WORKSPACE}"
echo "EMBA_WORK=${EMBA_WORK}"
echo "EMBA_TARGET=${EMBA_TARGET}"
echo "EMBA_LOG_DIR=${EMBA_LOG_DIR}"

test -e "$EMBA_TARGET"

cd /opt/emba

set +e
sudo -n ./emba \
  -l "$EMBA_LOG_DIR" \
  -f "$EMBA_TARGET" \
  -p /opt/emba/scan-profiles/full-scan.emba \
  -y
EMBA_RC=$?
set -e

echo "$EMBA_RC" > "${WORKSPACE}/results/emba/emba-exit-code.txt"

echo "=== Copying EMBA results back to Jenkins workspace ==="
if [ -d "$EMBA_LOG_DIR" ]; then
  sudo -n chown -R "$(id -u):$(id -g)" "$EMBA_LOG_DIR" || true
  cp -a "$EMBA_LOG_DIR/." "${WORKSPACE}/results/emba/" || true
fi

echo "=== EMBA artifacts ==="
find "${WORKSPACE}/results/emba" -maxdepth 3 -type f | sort | sed -n '1,120p' || true

echo "=== Cleaning temporary EMBA workdir ==="
rm -rf "$EMBA_WORK" || true

exit 0
'''
            }
        }

        stage('Hardening') {
            agent {
                docker {
                    image 'devsecops-agente:1.0'
                    reuseNode true
                    args '-u 101:103'
                }
            }

            steps {
                sh '''#!/usr/bin/env bash
set -euo pipefail

mkdir -p results/hardening

echo "=== Verifying hardening of main build artifact ==="
test -x build/src/mosquitto

checksec \
  --file=build/src/mosquitto \
  --output=json \
  > results/hardening/checksec.json

test -s results/hardening/checksec.json

python3 - <<'PY'
import json
from pathlib import Path

path = Path("results/hardening/checksec.json")
data = json.loads(path.read_text(encoding="utf-8"))
print(f"[OK] JSON válido: {path}")
print(json.dumps(data, indent=2))
PY
'''
            }
        }

        stage('Persist ETL Artifacts') {
            agent any

            steps {
                sh '''#!/usr/bin/env bash
set -euo pipefail

PROJECT="${PROJECT_NAME:-mosquitto}"
BUILD_ID_SAFE="${BUILD_NUMBER:-manual}"

DEST="/opt/devsecops-lab/artifacts/${PROJECT}/${BUILD_ID_SAFE}"
TMP_DEST="${DEST}.tmp"

echo "=== Persisting ETL artifact snapshot ==="
echo "PROJECT=${PROJECT}"
echo "BUILD_ID=${BUILD_ID_SAFE}"
echo "DEST=${DEST}"

test -d results || {
  echo "ERROR: results directory does not exist"
  exit 1
}

rm -rf "${TMP_DEST}"
mkdir -p "${TMP_DEST}/metadata"
mkdir -p "${TMP_DEST}/raw"

echo "=== Copying complete raw results directory ==="
cp -a results "${TMP_DEST}/raw/results"

test -d "${TMP_DEST}/raw/results"

echo "=== Generating metadata/build.json ==="
python3 - <<PY
import json
import os
import subprocess
from pathlib import Path
from datetime import datetime, timezone

tmp = Path("${TMP_DEST}")

def git(cmd):
    try:
        return subprocess.check_output(
            cmd,
            text=True,
            stderr=subprocess.DEVNULL
        ).strip()
    except Exception:
        return ""

metadata = {
    "project": "${PROJECT}",
    "language": os.environ.get("PROJECT_LANGUAGE", "C/C++"),
    "platform_type": os.environ.get("PROJECT_PLATFORM_TYPE", "linux_embedded"),
    "execution_type": os.environ.get("EXECUTION_TYPE", "ci_pipeline"),
    "jenkins_build_number": "${BUILD_ID_SAFE}",
    "jenkins_build_url": os.environ.get("BUILD_URL", ""),
    "job_name": os.environ.get("JOB_NAME", ""),
    "git_branch": os.environ.get("BRANCH_NAME", "") or git(["git", "rev-parse", "--abbrev-ref", "HEAD"]),
    "git_commit": os.environ.get("GIT_COMMIT", "") or git(["git", "rev-parse", "HEAD"]),
    "workspace": os.environ.get("WORKSPACE", ""),
    "persisted_at_utc": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
    "artifact_store": "${DEST}",
    "raw_results_path": "${DEST}/raw/results",
    "artifact_store_version": "1.0",
    "notes": "Complete raw results snapshot persisted for ETL. Jenkins also archives results/** as build evidence."
}

(tmp / "metadata" / "build.json").write_text(
    json.dumps(metadata, indent=2, ensure_ascii=False) + "\\n",
    encoding="utf-8"
)

print("[OK] metadata/build.json generated")
PY

echo "=== Generating metadata/inventories.json ==="
python3 - <<PY
import hashlib
import json
from pathlib import Path

tmp = Path("${TMP_DEST}")
dest = Path("${DEST}")

def sha256_or_empty(path: Path) -> str:
    if not path.is_file() or path.stat().st_size == 0:
        return ""

    h = hashlib.sha256()
    with path.open("rb") as f:
        for chunk in iter(lambda: f.read(1024 * 1024), b""):
            h.update(chunk)

    return h.hexdigest()

def size_or_zero(path: Path) -> int:
    return path.stat().st_size if path.is_file() else 0

source_sbom_tmp = tmp / "raw" / "results" / "sca" / "sbom-source.cyclonedx.json"
vendor_manifest_tmp = tmp / "raw" / "results" / "sca" / "vendor-manifest.cdx.json"
emba_sbom_tmp = tmp / "raw" / "results" / "emba" / "SBOM" / "EMBA_cyclonedx_sbom.json"

source_sbom_dest = dest / "raw" / "results" / "sca" / "sbom-source.cyclonedx.json"
vendor_manifest_dest = dest / "raw" / "results" / "sca" / "vendor-manifest.cdx.json"
emba_sbom_dest = dest / "raw" / "results" / "emba" / "SBOM" / "EMBA_cyclonedx_sbom.json"

registry = {
    "project": "${PROJECT}",
    "build_id": "${BUILD_ID_SAFE}",
    "inventories": [
        {
            "id": "source_sbom",
            "logical_name": "syft-source-sbom",
            "path": str(source_sbom_dest),
            "origin": "source_sbom",
            "source_type": "SYFT_SBOM",
            "scope": "source_or_build_inventory",
            "artifact_type": "SBOM",
            "detection_phase": "SCA_SOURCE_SBOM",
            "required": True,
            "sha256": sha256_or_empty(source_sbom_tmp),
            "size_bytes": size_or_zero(source_sbom_tmp)
        },
        {
            "id": "vendor_manifest",
            "logical_name": "curated-vendor-manifest",
            "path": str(vendor_manifest_dest),
            "origin": "vendor_manifest",
            "source_type": "VENDOR_MANIFEST",
            "scope": "curated_dependency_inventory",
            "artifact_type": "SBOM",
            "detection_phase": "SCA_VENDOR_MANIFEST",
            "required": True,
            "sha256": sha256_or_empty(vendor_manifest_tmp),
            "size_bytes": size_or_zero(vendor_manifest_tmp)
        },
        {
            "id": "emba_sbom",
            "logical_name": "emba-rootfs-sbom",
            "path": str(emba_sbom_dest),
            "origin": "emba_sbom",
            "source_type": "EMBA_SBOM",
            "scope": "runtime_rootfs_inventory",
            "artifact_type": "SBOM",
            "detection_phase": "SCA_FIRMWARE_SBOM",
            "required": False,
            "sha256": sha256_or_empty(emba_sbom_tmp),
            "size_bytes": size_or_zero(emba_sbom_tmp)
        }
    ]
}

(tmp / "metadata" / "inventories.json").write_text(
    json.dumps(registry, indent=2, ensure_ascii=False) + "\\n",
    encoding="utf-8"
)

print("[OK] metadata/inventories.json generated")
PY

echo "=== Validating persisted ETL snapshot ==="
python3 - <<PY
import json
from pathlib import Path

tmp = Path("${TMP_DEST}")

required_json = [
    tmp / "metadata" / "build.json",
    tmp / "metadata" / "inventories.json",
    tmp / "raw" / "results" / "sca" / "sbom-source.cyclonedx.json",
    tmp / "raw" / "results" / "sca" / "vendor-manifest.cdx.json",
    tmp / "raw" / "results" / "sca" / "grype-source.json",
    tmp / "raw" / "results" / "sca" / "grype-vendor-manifest.json"
]

for path in required_json:
    if not path.is_file() or path.stat().st_size == 0:
        raise SystemExit(f"Required artifact missing or empty: {path}")

    json.loads(path.read_text(encoding="utf-8"))
    print(f"[OK] JSON valid: {path}")

for path in [
    tmp / "raw" / "results" / "sca" / "sbom-source.cyclonedx.json",
    tmp / "raw" / "results" / "sca" / "vendor-manifest.cdx.json",
    tmp / "raw" / "results" / "emba" / "SBOM" / "EMBA_cyclonedx_sbom.json"
]:
    if not path.exists() or path.stat().st_size == 0:
        print(f"[WARN] Optional CycloneDX inventory missing: {path}")
        continue

    data = json.loads(path.read_text(encoding="utf-8"))

    if data.get("bomFormat") != "CycloneDX":
        raise SystemExit(f"Not CycloneDX: {path}")

    print(f"[OK] CycloneDX valid: {path} | components={len(data.get('components', []))}")
PY

echo "=== Publishing artifact snapshot atomically ==="
rm -rf "${DEST}"
mv "${TMP_DEST}" "${DEST}"

echo "=== Persisted ETL artifact snapshot ==="
find "${DEST}" -maxdepth 5 -type f | sort | sed -n '1,300p'

echo "=== Artifact store size ==="
du -sh "${DEST}"

echo "=== ETL artifact persistence completed ==="
'''
            }
        }
    }

    post {
        always {
            node('') {
                archiveArtifacts artifacts: 'results/**', allowEmptyArchive: true
                echo "Artefactos Jenkins: ${env.BUILD_URL}artifact/results/"
                echo "Snapshot ETL local: /opt/devsecops-lab/artifacts/${env.PROJECT_NAME}/${env.BUILD_NUMBER}/"
            }
        }

        success {
            echo 'Pipeline OK'
        }

        failure {
            echo 'Pipeline FALLIDO'
        }
    }
}
