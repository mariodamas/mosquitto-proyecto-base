pipeline {
  agent none

  options {
    timestamps()
    disableConcurrentBuilds()
    buildDiscarder(logRotator(numToKeepStr: '20'))
    skipDefaultCheckout(true)
  }

  parameters {
    booleanParam(name: 'RUN_SECRETS', defaultValue: true, description: 'Run Gitleaks')
    booleanParam(name: 'RUN_CODEQL', defaultValue: true, description: 'Run CodeQL SAST')
    booleanParam(name: 'RUN_COVERITY_STANDARD', defaultValue: true, description: 'Run Coverity standard SAST')
    booleanParam(name: 'RUN_COVERITY_CERT', defaultValue: true, description: 'Run Coverity CERT C')
    booleanParam(name: 'RUN_COVERITY_MISRA', defaultValue: false, description: 'Run Coverity MISRA C 2012')
    booleanParam(name: 'RUN_SCA', defaultValue: true, description: 'Run Syft and Grype SCA')
    booleanParam(name: 'RUN_OWASPDC', defaultValue: true, description: 'Run OWASP Dependency-Check')
    booleanParam(name: 'RUN_FUZZING', defaultValue: true, description: 'Run project fuzzing hook when present')
    booleanParam(name: 'RUN_FIRMWARE', defaultValue: true, description: 'Run project firmware/rootfs packaging hook when present')
    booleanParam(name: 'RUN_EMBA', defaultValue: true, description: 'Run EMBA on firmware or build artifact')
    booleanParam(name: 'RUN_HARDENING', defaultValue: true, description: 'Run hardening checks on the main artifact')
    booleanParam(name: 'RUN_ETL', defaultValue: true, description: 'Ingest persisted results into PostgreSQL')

    booleanParam(name: 'ALLOW_FUZZING_FAILURES', defaultValue: true, description: 'Do not fail CI on fuzzing findings')
    string(name: 'FUZZING_CAMPAIGN_TIME', defaultValue: '300', description: 'Seconds per fuzzing harness')
  }

  environment {
    LAB = '/opt/devsecops-lab'
    RESULTS = 'results'
    PLATFORM_DIR = '/opt/devsecops-lab/platform/devsecops_platform'
    EXECUTION_TYPE = 'ci_pipeline'
    // Constantes de plataforma (no son decisiones por ejecución, no se exponen en la UI):
    AGENT_IMAGE = 'devsecops-agente:1.0'
    INGESTOR_IMAGE = "${env.INGESTOR_IMAGE ?: 'cipherbit-appsec-ingestor:local'}"
    DEVSECOPS_DOCKER_NETWORK = "${env.DEVSECOPS_DOCKER_NETWORK ?: 'cipherbit_ingestion'}"
    DEVSECOPS_DB_HOST = 'postgres'
    DEVSECOPS_DB_PORT = '5432'
    DEVSECOPS_DB_NAME = 'cipherbit'
    DEVSECOPS_DB_USER = 'cipherbit_ingestor'
    // Contrato del proyecto integrado: este Jenkinsfile es autocontenido.
    PROJECT_NAME = 'mosquitto'
    PROJECT_DB_NAME = 'mosquitto-proyecto-base'
    PROJECT_REPO_URL = 'https://github.com/mariodamas/mosquitto-proyecto-base'
    PROJECT_LANGUAGE = 'C/C++'
    PROJECT_PLATFORM_TYPE = 'linux_embedded'
    BUILD_ARTIFACT = 'build/src/mosquitto'
    HARDENING_ARTIFACT = 'build/src/mosquitto'
    BUILD_TYPE = 'Release'
    CC = 'clang'
    CXX = 'clang++'
    CODEQL_LANGUAGE = 'cpp'
    CODEQL_QUERY_PACK = 'cpp-queries'
    CODEQL_SUITE_GLOB = 'cpp-security-and-quality.qls'
    COVERITY_COMPILER = 'clang'
    COVERITY_COMPTYPE = 'clangcc'
    COVERITY_CERT_CONFIG = '/opt/coverity/config/coding-standards/cert-c/cert-c-all.config'
    COVERITY_MISRA_CONFIG = '/opt/coverity/config/coding-standards/misrac2012/misrac2012-all.config'
    MANUAL_MANIFEST_REQUIRED = 'false'
    MANUAL_MANIFEST_PATH = ''
    MANUAL_MANIFEST_EVIDENCE_PATH = ''
    MANUAL_MANIFEST_VALIDATOR = ''
    FUZZING_PERSISTENT_CORPUS_NAME = 'mosquitto'
    FIRMWARE_TARGET_NAME = 'mosquitto-rootfs.tar.gz'
    FIRMWARE_BINARY_INSTALL_PATH = 'usr/sbin/mosquitto'
    FIRMWARE_VERSION = '2.0.18'
    FIRMWARE_OS_NAME = 'Mosquitto DevSecOps Lab Firmware'
    FIRMWARE_OS_ID = 'mosquitto-devsecops-lab'
    FIRMWARE_CLIENT_ARTIFACTS = 'build/client/mosquitto_pub:usr/bin/mosquitto_pub build/client/mosquitto_sub:usr/bin/mosquitto_sub'
    FIRMWARE_PACKAGE_STATUS_PACKAGES = 'libc6 libssl3 libssl-dev openssl zlib1g libwebsockets17'
    FIRMWARE_INIT_COMMAND = '/usr/sbin/mosquitto -c /etc/mosquitto/mosquitto.conf'
    // Endpoint de la plataforma: se define una vez como variable global de Jenkins
    // (Manage Jenkins > System > Global properties) y se reutiliza en todos los
    // proyectos. El fallback cubre ejecución local sin esa propiedad configurada.
    DEVSECOPS_API_BASE_URL = "${env.DEVSECOPS_API_BASE_URL ?: 'http://127.0.0.1:3000/api/v1'}"
    DEVSECOPS_API_CONTAINER_BASE_URL = "${env.DEVSECOPS_API_CONTAINER_BASE_URL ?: 'http://backend:8000/api/v1'}"
  }

  stages {
    stage('Checkout') {
      agent any
      steps {
        checkout scm
        sh '''#!/usr/bin/env bash
set -euo pipefail

rm -rf results build build-* build-coverity build-rootfs coverity-config .codeql-cache .cache .codeql-home .lab/fuzzing/findings || true
mkdir -p results/sast results/compliance results/sca results/fuzzing results/emba results/firmware results/hardening results/build results/metadata

: "${PROJECT_NAME:?PROJECT_NAME is required}"
: "${BUILD_ARTIFACT:?BUILD_ARTIFACT is required}"

echo "Project: ${PROJECT_NAME}"
echo "Build artifact: ${BUILD_ARTIFACT}"
'''
      }
    }

    stage('Build') {
      agent {
        docker {
          image "${AGENT_IMAGE}"
          reuseNode true
          args '-u 101:103 --cap-drop ALL --security-opt no-new-privileges:true --pids-limit 1024'
        }
      }
      steps {
          sh '''#!/usr/bin/env bash
set -euo pipefail

JOBS="${JOBS:-$(nproc)}"
cmake -S . -B build \
  -DCMAKE_BUILD_TYPE="${BUILD_TYPE}" \
  -DCMAKE_C_COMPILER="${CC}" \
  -DCMAKE_CXX_COMPILER="${CXX}" \
  -DCMAKE_EXPORT_COMPILE_COMMANDS=ON \
  -DDOCUMENTATION=OFF \
  -DCMAKE_C_FLAGS_RELEASE="-O2 -D_FORTIFY_SOURCE=2 -fstack-protector-strong -fPIE" \
  -DCMAKE_CXX_FLAGS_RELEASE="-O2 -D_FORTIFY_SOURCE=2 -fstack-protector-strong -fPIE" \
  -DCMAKE_EXE_LINKER_FLAGS="-pie -Wl,-z,relro,-z,now"
cmake --build build --clean-first -j"${JOBS}"
test -e "${BUILD_ARTIFACT}"
cp -a "${BUILD_ARTIFACT}" results/build/
'''
      }
    }

    stage('Secrets') {
      when { expression { params.RUN_SECRETS } }
      agent {
        docker {
          image "${AGENT_IMAGE}"
          reuseNode true
          args '-u 101:103 --cap-drop ALL --security-opt no-new-privileges:true --pids-limit 1024'
        }
      }
      steps {
          sh '''#!/usr/bin/env bash
set -euo pipefail

TMP_SRC="$(mktemp -d)"
trap 'rm -rf "${TMP_SRC}"' EXIT

tar \
  --exclude='./.git' \
  --exclude='./.github' \
  --exclude='./results' \
  --exclude='./build' \
  --exclude='./build-*' \
  --exclude='./build-coverity' \
  --exclude='./build-rootfs' \
  --exclude='./coverity-config' \
  --exclude='./.codeql-cache' \
  --exclude='./.cache' \
  --exclude='./.codeql-home' \
  --exclude='./.lab/fuzzing/findings' \
  -cf - . | tar -xf - -C "${TMP_SRC}"

gitleaks detect \
  --source "${TMP_SRC}" \
  --no-git \
  --report-format json \
  --report-path results/sast/gitleaks.json \
  --exit-code 0

python3 -m json.tool results/sast/gitleaks.json >/dev/null
'''
      }
    }

    stage('CodeQL') {
      when { expression { params.RUN_CODEQL } }
      agent {
        docker {
          image "${AGENT_IMAGE}"
          reuseNode true
          args '-u 101:103 --cap-drop ALL --security-opt no-new-privileges:true --pids-limit 1024 -v /opt/devsecops-lab/codeql:/opt/codeql:ro'
        }
      }
      steps {
          sh '''#!/usr/bin/env bash
set -euo pipefail

export HOME="${WORKSPACE}/.codeql-home"
JOBS="${JOBS:-$(nproc)}"
mkdir -p "${HOME}/.codeql"
rm -rf build/codeql-db build-codeql

cmake -S . -B build-codeql \
  -DCMAKE_BUILD_TYPE="${BUILD_TYPE}" \
  -DCMAKE_C_COMPILER="${CC}" \
  -DCMAKE_CXX_COMPILER="${CXX}" \
  -DCMAKE_EXPORT_COMPILE_COMMANDS=ON \
  -DDOCUMENTATION=OFF \
  -DCMAKE_C_FLAGS_RELEASE="-O2 -D_FORTIFY_SOURCE=2 -fstack-protector-strong -fPIE" \
  -DCMAKE_CXX_FLAGS_RELEASE="-O2 -D_FORTIFY_SOURCE=2 -fstack-protector-strong -fPIE" \
  -DCMAKE_EXE_LINKER_FLAGS="-pie -Wl,-z,relro,-z,now"

/opt/codeql/codeql/codeql database create build/codeql-db \
  --language="${CODEQL_LANGUAGE}" \
  --source-root=. \
  --command="cmake --build build-codeql --clean-first -j${JOBS}"

if [ -n "${CODEQL_SUITE:-}" ]; then
  SUITE="${CODEQL_SUITE}"
else
  SUITE="$(find /opt/codeql/codeql/qlpacks -path "*/codeql/${CODEQL_QUERY_PACK:-cpp-queries}/*/codeql-suites/${CODEQL_SUITE_GLOB:-*security-and-quality.qls}" | sort | tail -1)"
fi
test -n "${SUITE}"

/opt/codeql/codeql/codeql database analyze build/codeql-db \
  "${SUITE}" \
  --format=sarif-latest \
  --output=results/sast/codeql.sarif

python3 -m json.tool results/sast/codeql.sarif >/dev/null
'''
      }
    }

    stage('Coverity') {
      when { expression { params.RUN_COVERITY_STANDARD || params.RUN_COVERITY_CERT || params.RUN_COVERITY_MISRA } }
      agent {
        docker {
          image "${AGENT_IMAGE}"
          reuseNode true
          args '-u 101:103 --cap-drop ALL --security-opt no-new-privileges:true --pids-limit 1024'
        }
      }
      steps {
        withCredentials([file(credentialsId: 'coverity-license', variable: 'COV_LICENSE')]) {
          sh '''#!/usr/bin/env bash
set -euo pipefail

test -r "${COV_LICENSE}"
JOBS="${JOBS:-$(nproc)}"

rm -rf build-coverity coverity-config
mkdir -p coverity-config results/sast results/compliance

/opt/coverity/bin/cov-configure \
  --config coverity-config/coverity_config.xml \
  --template \
  --compiler "${COVERITY_COMPILER:-clang}" \
  --comptype "${COVERITY_COMPTYPE:-clangcc}"

cmake -S . -B build-coverity \
  -DCMAKE_BUILD_TYPE="${BUILD_TYPE}" \
  -DCMAKE_C_COMPILER="${CC}" \
  -DCMAKE_CXX_COMPILER="${CXX}" \
  -DCMAKE_EXPORT_COMPILE_COMMANDS=ON \
  -DDOCUMENTATION=OFF \
  -DCMAKE_C_FLAGS_RELEASE="-O2 -D_FORTIFY_SOURCE=2 -fstack-protector-strong -fPIE" \
  -DCMAKE_CXX_FLAGS_RELEASE="-O2 -D_FORTIFY_SOURCE=2 -fstack-protector-strong -fPIE" \
  -DCMAKE_EXE_LINKER_FLAGS="-pie -Wl,-z,relro,-z,now"

/opt/coverity/bin/cov-build \
  --config coverity-config/coverity_config.xml \
  --dir build-coverity/cov-int-base \
  --emit-complementary-info \
  cmake --build build-coverity --clean-first -j"${JOBS}"

test -d build-coverity/cov-int-base

run_coverity() {
  local profile="$1"
  local mode="$2"
  local config="$3"
  local output_json="$4"
  local output_log="$5"
  local cov_dir="build-coverity/cov-int-${profile}"

  rm -rf "${cov_dir}"
  cp -a build-coverity/cov-int-base "${cov_dir}"
  /opt/coverity/bin/cov-manage-emit --dir "${cov_dir}" reset-host-name

  if [ "${mode}" = "standard" ]; then
    /opt/coverity/bin/cov-analyze \
      --security-file "${COV_LICENSE}" \
      --dir "${cov_dir}" \
      --all 2>&1 | tee "${output_log}"
  else
    test -f "${config}"
    /opt/coverity/bin/cov-analyze \
      --security-file "${COV_LICENSE}" \
      --dir "${cov_dir}" \
      --disable-default \
      --coding-standard-config "${config}" 2>&1 | tee "${output_log}"
  fi

  /opt/coverity/bin/cov-format-errors \
    --security-file "${COV_LICENSE}" \
    --dir "${cov_dir}" \
    --json-output-v8 "${output_json}"

  python3 -m json.tool "${output_json}" >/dev/null
}

if [ "${RUN_COVERITY_STANDARD:-true}" = "true" ]; then
  run_coverity standard standard "" results/sast/coverity-standard.json results/sast/coverity-standard-analyze.log
  cp results/sast/coverity-standard.json results/sast/coverity.json
fi

if [ "${RUN_COVERITY_CERT:-true}" = "true" ]; then
  run_coverity cert compliance "${COVERITY_CERT_CONFIG:-/opt/coverity/config/coding-standards/cert-c/cert-c-all.config}" results/compliance/coverity-cert.json results/compliance/coverity-cert-analyze.log
fi

if [ "${RUN_COVERITY_MISRA:-false}" = "true" ]; then
  run_coverity misra compliance "${COVERITY_MISRA_CONFIG:-/opt/coverity/config/coding-standards/misrac2012/misrac2012-all.config}" results/compliance/coverity-misra.json results/compliance/coverity-misra-analyze.log
fi
'''
      }
    }
    }


    stage('SCA') {
      when { expression { params.RUN_SCA } }
      agent {
        docker {
          image "${AGENT_IMAGE}"
          reuseNode true
          args '-u 101:103 --cap-drop ALL --security-opt no-new-privileges:true --pids-limit 1024 --network cipherbit_jenkins_api -v /opt/devsecops-lab/platform:/opt/devsecops-lab/platform:ro -v /opt/devsecops-lab/vuln-dbs/grype:/home/jenkins/.cache/grype:ro -v /opt/devsecops-lab/vuln-dbs:/mnt/vuln-dbs:ro -v /opt/devsecops-lab/vuln-dbs/owaspdc-data:/mnt/owaspdc-data:ro -e GRYPE_DB_AUTO_UPDATE=false -e GRYPE_DB_CACHE_DIR=/home/jenkins/.cache/grype -e GRYPE_DB_MAX_ALLOWED_BUILT_AGE=720h'
        }
      }
      steps {
          sh '''#!/usr/bin/env bash
set -euo pipefail

mkdir -p "${WORKSPACE}/.cache" results/sca
export XDG_CACHE_HOME="${WORKSPACE}/.cache"
export GRYPE_DB_AUTO_UPDATE=false
export GRYPE_DB_CACHE_DIR=/home/jenkins/.cache/grype
export GRYPE_DB_MAX_ALLOWED_BUILT_AGE="${GRYPE_DB_MAX_ALLOWED_BUILT_AGE:-720h}"

if [ -s /mnt/vuln-dbs/current-bundle-manifest.json ]; then
  cp /mnt/vuln-dbs/current-bundle-manifest.json results/sca/current-bundle-manifest.json
  python3 -m json.tool results/sca/current-bundle-manifest.json >/dev/null
else
  echo "WARNING: active vulnerability bundle manifest not found; vulnerability_bundle linkage may be absent."
fi

syft . \
  -o cyclonedx-json=results/sca/sbom-source.cyclonedx.json \
  --exclude './.git/**' \
  --exclude './.github/**' \
  --exclude './results/**' \
  --exclude './build/**' \
  --exclude './build-*/**' \
  --exclude './build-coverity/**' \
  --exclude './build-rootfs/**' \
  --exclude './coverity-config/**' \
  --exclude './.codeql-cache/**' \
  --exclude './.cache/**' \
  --exclude './.codeql-home/**'

python3 -m json.tool results/sca/sbom-source.cyclonedx.json >/dev/null

if [ -n "${DEVSECOPS_API_CONTAINER_BASE_URL:-}" ]; then
  export NO_PROXY="${NO_PROXY:+${NO_PROXY},}backend"
  export no_proxy="${no_proxy:+${no_proxy},}backend"
  UI_MANUAL_MANIFEST="results/sca/manual-manifest.ui.cdx.json"
  if python3 "${PLATFORM_DIR}/scripts/catalog/export-manual-manifest.py" \
    --api-base-url "${DEVSECOPS_API_CONTAINER_BASE_URL}" \
    --project-name "${PROJECT_DB_NAME:-${PROJECT_NAME}}" \
    --output "${UI_MANUAL_MANIFEST}"; then
    UI_MANUAL_COUNT="$(python3 - "${UI_MANUAL_MANIFEST}" <<'PY'
import json
import sys
from pathlib import Path
path = Path(sys.argv[1])
print(len(json.loads(path.read_text(encoding="utf-8")).get("components", [])))
PY
    )"
    if [ "${UI_MANUAL_COUNT}" -gt 0 ]; then
      mv "${UI_MANUAL_MANIFEST}" results/sca/manual-manifest.cdx.json
      echo "Using UI manual component catalog with ${UI_MANUAL_COUNT} components."
    else
      rm -f "${UI_MANUAL_MANIFEST}"
      echo "WARNING: UI manual component catalog is empty; skipping manual manifest analysis."
    fi
  else
    rm -f "${UI_MANUAL_MANIFEST}"
    echo "WARNING: UI manual component export failed; skipping manual manifest analysis."
  fi
fi

if [ ! -s results/sca/manual-manifest.cdx.json ]; then
  echo "WARNING: manual manifest not available from API; continuing without manual manifest analysis."
fi

grype db status -o json > results/sca/grype-db-status.json
grype sbom:results/sca/sbom-source.cyclonedx.json -o json --file results/sca/grype-source.json

if [ -s results/sca/manual-manifest.cdx.json ]; then
  grype sbom:results/sca/manual-manifest.cdx.json -o json --file results/sca/grype-manual-manifest.json \
    || echo "WARNING: manual manifest analysis failed; continuing without blocking the pipeline."
fi

python3 -m json.tool results/sca/grype-db-status.json >/dev/null
python3 -m json.tool results/sca/grype-source.json >/dev/null
[ ! -s results/sca/grype-manual-manifest.json ] || python3 -m json.tool results/sca/grype-manual-manifest.json >/dev/null \
  || echo "WARNING: manual manifest analysis output is not valid JSON; continuing without blocking the pipeline."

if [ "${RUN_OWASPDC:-true}" = "true" ]; then
  ODC_TMP="/tmp/owaspdc-data-${BUILD_TAG:-$$}"
  rm -rf "${ODC_TMP}"
  mkdir -p "${ODC_TMP}"
  cp -a /mnt/owaspdc-data/. "${ODC_TMP}/"

  /opt/dependency-check/bin/dependency-check.sh \
    --project "${PROJECT_NAME}" \
    --scan . \
    --exclude '.git/**' \
    --exclude '.github/**' \
    --exclude 'results/**' \
    --exclude 'build/**' \
    --exclude 'build-*/**' \
    --exclude 'build-coverity/**' \
    --exclude 'build-rootfs/**' \
    --exclude 'coverity-config/**' \
    --exclude '.codeql-cache/**' \
    --exclude '.cache/**' \
    --exclude '.codeql-home/**' \
    --format JSON \
    --format HTML \
    --out results/sca \
    --data "${ODC_TMP}" \
    --noupdate \
    --enableExperimental \
    --disableAssembly || true

  [ ! -f results/sca/dependency-check-report.json ] || cp results/sca/dependency-check-report.json results/sca/owaspdc.json
  [ ! -s results/sca/owaspdc.json ] || python3 -m json.tool results/sca/owaspdc.json >/dev/null
fi
'''
      }
    }

    stage('Fuzzing') {
      when { expression { params.RUN_FUZZING } }
      agent {
        docker {
          image "${AGENT_IMAGE}"
          reuseNode true
          args '-u 101:103 --cap-drop ALL --security-opt no-new-privileges:true --pids-limit 1024 -v /opt/devsecops-lab/fuzzing-corpus:/opt/devsecops-lab/fuzzing-corpus:rw'
        }
      }
      steps {
          sh '''#!/usr/bin/env bash
set -euo pipefail

campaign_time="${FUZZING_CAMPAIGN_TIME:-300}"
allow_failures="${ALLOW_FUZZING_FAILURES:-true}"
corpus_name="${FUZZING_PERSISTENT_CORPUS_NAME:-${PROJECT_NAME}}"

if ! [[ "${campaign_time}" =~ ^[0-9]+$ ]] || [ "${campaign_time}" -lt 1 ]; then
  echo "ERROR: FUZZING_CAMPAIGN_TIME must be a positive integer number of seconds" >&2
  exit 1
fi

test -d .lab/fuzzing
export ALLOW_FUZZING_FAILURES="${allow_failures}"

JOBS="${JOBS:-$(nproc)}"
cmake -S . -B build \
  -DCMAKE_BUILD_TYPE="${BUILD_TYPE}" \
  -DCMAKE_C_COMPILER="${CC}" \
  -DCMAKE_CXX_COMPILER="${CXX}" \
  -DCMAKE_EXPORT_COMPILE_COMMANDS=ON \
  -DDOCUMENTATION=OFF \
  -DCMAKE_C_FLAGS_RELEASE="-O2 -D_FORTIFY_SOURCE=2 -fstack-protector-strong -fPIE" \
  -DCMAKE_CXX_FLAGS_RELEASE="-O2 -D_FORTIFY_SOURCE=2 -fstack-protector-strong -fPIE" \
  -DCMAKE_EXE_LINKER_FLAGS="-pie -Wl,-z,relro,-z,now"
cmake --build build --clean-first -j"${JOBS}"
rm -rf .lab/fuzzing/findings

(
  cd .lab/fuzzing
  python3 corpus/generate_corpus.py
  bash ./build_libfuzzer.sh

  FUZZING_PERSISTENT_CORPUS_DIR="/opt/devsecops-lab/fuzzing-corpus/${corpus_name}" \
  ALLOW_FUZZING_FAILURES="${allow_failures}" \
  CAMPAIGN_TIME="${campaign_time}" \
  bash ./run_campaigns.sh libfuzzer
)

mkdir -p results/fuzzing
if [ -d .lab/fuzzing/findings ]; then
  cp -a .lab/fuzzing/findings/. results/fuzzing/
fi

if [ -d .lab/fuzzing/build ]; then
  mkdir -p results/fuzzing/build
  cp -a .lab/fuzzing/build/. results/fuzzing/build/
fi

python3 - <<'PY'
import os
import sys
from pathlib import Path

allow_failures = os.environ.get("ALLOW_FUZZING_FAILURES", "true").lower() == "true"
root = Path("results/fuzzing/libfuzzer")

if not root.exists():
    print("[WARN] No libFuzzer results were produced")
    sys.exit(0)

infra_errors = []
harness_failures = []

for harness_dir in sorted(path for path in root.iterdir() if path.is_dir()):
    name = harness_dir.name
    log = harness_dir / "run.log"
    exit_code = harness_dir / "exit_code.txt"
    metadata = harness_dir / "metadata.txt"
    corpus = harness_dir / "corpus"

    if not log.is_file() or log.stat().st_size == 0:
        infra_errors.append(f"{name}: run.log missing or empty")
    if not exit_code.is_file():
        infra_errors.append(f"{name}: exit_code.txt missing")
    if not metadata.is_file():
        infra_errors.append(f"{name}: metadata.txt missing")
    if not corpus.is_dir() or not any(corpus.iterdir()):
        infra_errors.append(f"{name}: corpus missing or empty")

    if exit_code.is_file():
        code = exit_code.read_text(encoding="utf-8", errors="replace").strip()
        print(f"[OK] {name}: exit_code={code} log={log.stat().st_size if log.exists() else 0}B")
        if code != "0":
            harness_failures.append(f"{name}: exit_code={code}")

if infra_errors:
    for error in infra_errors:
        print(f"[FAIL] {error}", file=sys.stderr)
    sys.exit(1)

if harness_failures and not allow_failures:
    for failure in harness_failures:
        print(f"[FAIL] {failure}", file=sys.stderr)
    sys.exit(1)
PY
'''
      }
    }

    stage('Firmware Package') {
      when { expression { params.RUN_FIRMWARE } }
      agent {
        docker {
          image "${AGENT_IMAGE}"
          reuseNode true
          args '-u 101:103 --cap-drop ALL --security-opt no-new-privileges:true --pids-limit 1024'
        }
      }
      steps {
          sh '''#!/usr/bin/env bash
set -euo pipefail

build_artifact="${BUILD_ARTIFACT:?BUILD_ARTIFACT is required}"
target_name="${FIRMWARE_TARGET_NAME:-${PROJECT_NAME}-rootfs.tar.gz}"
binary_install_path="${FIRMWARE_BINARY_INSTALL_PATH:-usr/bin/$(basename "${build_artifact}")}"
firmware_version="${FIRMWARE_VERSION:-unknown}"
firmware_os_name="${FIRMWARE_OS_NAME:-${PROJECT_NAME} DevSecOps Lab Firmware}"
firmware_os_id="${FIRMWARE_OS_ID:-${PROJECT_NAME}-devsecops-lab}"
rootfs="${WORKSPACE:-$(pwd)}/build-rootfs/rootfs"

rm -rf "${rootfs}"
mkdir -p "${rootfs}" results/firmware

install_file() {
  local src="$1"
  local dst_rel="$2"
  [ -e "${src}" ] || return 0
  mkdir -p "${rootfs}/$(dirname "${dst_rel}")"
  cp -a "${src}" "${rootfs}/${dst_rel}"
}

test -e "${build_artifact}"
install_file "${build_artifact}" "${binary_install_path}"

for item in ${FIRMWARE_CLIENT_ARTIFACTS:-}; do
  install_file "${item%%:*}" "${item#*:}"
done

mkdir -p \
  "${rootfs}/etc/init.d" \
  "${rootfs}/etc/mosquitto" \
  "${rootfs}/tmp" \
  "${rootfs}/var/lib/mosquitto" \
  "${rootfs}/var/log"

cat > "${rootfs}/etc/os-release" <<EOF
NAME="${firmware_os_name}"
ID=${firmware_os_id}
VERSION_ID="${firmware_version}"
PRETTY_NAME="${firmware_os_name} ${firmware_version}"
EOF

cat > "${rootfs}/etc/mosquitto/mosquitto.conf" <<'EOF'
pid_file /tmp/mosquitto.pid
persistence true
persistence_location /var/lib/mosquitto/
log_dest file /var/log/mosquitto.log
listener 1883
allow_anonymous true
EOF

if [ -n "${FIRMWARE_INIT_COMMAND:-}" ]; then
  cat > "${rootfs}/etc/init.d/S50${PROJECT_NAME}" <<EOF
#!/bin/sh
case "\$1" in
  start)
    ${FIRMWARE_INIT_COMMAND}
    ;;
  stop)
    killall ${PROJECT_NAME} || true
    ;;
  *)
    echo "Usage: \$0 {start|stop}"
    exit 1
    ;;
esac
EOF
  chmod +x "${rootfs}/etc/init.d/S50${PROJECT_NAME}"
fi

if command -v ldd >/dev/null 2>&1 && [ -x "${build_artifact}" ]; then
  ldd "${build_artifact}" | tee "results/firmware/${PROJECT_NAME}-ldd.txt" || true

  ROOTFS="${rootfs}" BUILD_ARTIFACT="${build_artifact}" python3 - <<'PY'
import os
import re
import shutil
import subprocess
from pathlib import Path

rootfs = Path(os.environ["ROOTFS"])
binary = Path(os.environ["BUILD_ARTIFACT"])
manifest = Path("results/firmware/rootfs-copied-libraries.txt")

try:
    output = subprocess.check_output(["ldd", str(binary)], text=True, stderr=subprocess.STDOUT)
except Exception as exc:
    manifest.write_text(f"ldd failed: {exc}\\n", encoding="utf-8")
    raise SystemExit(0)

paths = set()
for line in output.splitlines():
    for match in re.findall(r"(/[^\\s]+)", line):
        candidate = Path(match)
        if candidate.exists():
            paths.add(candidate)

copied = []
for src in sorted(paths):
    dst = rootfs / src.relative_to("/")
    dst.parent.mkdir(parents=True, exist_ok=True)
    try:
        shutil.copy2(src, dst)
        copied.append(f"{src} -> {dst.relative_to(rootfs)}")
    except Exception as exc:
        copied.append(f"{src} -> COPY_FAILED: {exc}")

manifest.write_text("\\n".join(copied) + "\\n", encoding="utf-8")
print(f"[OK] copied {len(copied)} dynamic library entries")
PY
fi

mkdir -p "${rootfs}/var/lib/dpkg"
if command -v dpkg-query >/dev/null 2>&1 && [ -n "${FIRMWARE_PACKAGE_STATUS_PACKAGES:-}" ]; then
  # shellcheck disable=SC2086
  dpkg-query -W -f='Package: ${binary:Package}\\nVersion: ${Version}\\nArchitecture: ${Architecture}\\nStatus: install ok installed\\n\\n' \
    ${FIRMWARE_PACKAGE_STATUS_PACKAGES} > "${rootfs}/var/lib/dpkg/status" 2>/dev/null || true
fi

if [ ! -s "${rootfs}/var/lib/dpkg/status" ]; then
  cat > "${rootfs}/var/lib/dpkg/status" <<EOF
Package: ${PROJECT_NAME}-devsecops-lab
Version: ${firmware_version}
Architecture: amd64
Status: install ok installed
Description: Synthetic package metadata for DevSecOps lab firmware.
EOF
fi

find "${rootfs}" -maxdepth 5 -type f | sort > results/firmware/rootfs-file-list.txt

firmware_target="results/firmware/${target_name}"
tar -C "${rootfs}" -czf "${firmware_target}" .
test -s "${firmware_target}"
printf '%s\\n' "${firmware_target}" > results/firmware/firmware-target.txt
echo "[OK] firmware package: ${firmware_target}"
'''
      }
    }

    stage('EMBA') {
      when { expression { params.RUN_EMBA } }
      // Transitional deployment: EMBA remains installed on the current Jenkins host.
      agent any
      steps {
          sh '''#!/usr/bin/env bash
set -euo pipefail

mkdir -p results/emba
rm -rf results/emba/*

TARGET=""
if [ -s results/firmware/firmware-target.txt ]; then
  TARGET="$(sed -n '1p' results/firmware/firmware-target.txt)"
fi

if [ -z "${TARGET}" ]; then
  TARGET="$(find results/firmware -maxdepth 1 -type f \\( -name '*.tar.gz' -o -name '*.tgz' -o -name '*.tar' -o -name '*.img' -o -name '*.bin' \\) | sort | head -1 || true)"
fi

if [ -z "${TARGET}" ]; then
  TARGET="${BUILD_ARTIFACT}"
fi

test -e "${TARGET}"

SAFE_JOB="$(printf '%s' "${JOB_NAME:-job}" | tr '/: ' '___' | tr -cd 'A-Za-z0-9_.-')"
SAFE_BUILD="$(printf '%s' "${BUILD_NUMBER:-manual}" | tr -cd 'A-Za-z0-9_.-')"
EMBA_WORK="/tmp/emba/${SAFE_JOB:-job}-${SAFE_BUILD:-manual}"
EMBA_INPUT_DIR="${EMBA_WORK}/input"
EMBA_LOG_DIR="${EMBA_WORK}/logs"

rm -rf "${EMBA_WORK}"
mkdir -p "${EMBA_INPUT_DIR}" "${EMBA_LOG_DIR}"
cp "${TARGET}" "${EMBA_INPUT_DIR}/target"

set +e
cd /opt/emba
sudo -n ./emba \
  -l "${EMBA_LOG_DIR}" \
  -f "${EMBA_INPUT_DIR}/target" \
  -p /opt/emba/scan-profiles/full-scan.emba \
  -y
EMBA_RC=$?
set -e

echo "${EMBA_RC}" > "${WORKSPACE}/results/emba/emba-exit-code.txt"
sudo -n chown -R "$(id -u):$(id -g)" "${EMBA_LOG_DIR}" || true
cp -a "${EMBA_LOG_DIR}/." "${WORKSPACE}/results/emba/" || true
rm -rf "${EMBA_WORK}" || true
exit 0
'''
      }
    }

    stage('Hardening') {
      when { expression { params.RUN_HARDENING } }
      agent {
        docker {
          image "${AGENT_IMAGE}"
          reuseNode true
          args '-u 101:103 --cap-drop ALL --security-opt no-new-privileges:true --pids-limit 1024'
        }
      }
      steps {
          sh '''#!/usr/bin/env bash
set -euo pipefail

ARTIFACT="${HARDENING_ARTIFACT:-${BUILD_ARTIFACT}}"
test -e "${ARTIFACT}"
mkdir -p results/hardening
checksec --file="${ARTIFACT}" --output=json > results/hardening/checksec.json
python3 -m json.tool results/hardening/checksec.json >/dev/null
'''
      }
    }

    stage('Persist Artifacts') {
      agent any
      steps {
        sh '''#!/usr/bin/env bash
set -euo pipefail
bash "${PLATFORM_DIR}/scripts/ci/persist-devsecops-artifacts.sh"
'''
      }
    }

    stage('ETL Ingest') {
      when { expression { params.RUN_ETL } }
      agent any
      steps {
        catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
          withCredentials([
            file(credentialsId: 'devsecops-ingestor-db-password', variable: 'DEVSECOPS_DB_PASSWORD_FILE'),
            file(credentialsId: 'devsecops-secret-fingerprint-key', variable: 'DEVSECOPS_SECRET_FINGERPRINT_KEY_FILE')
          ]) {
            sh '''#!/usr/bin/env bash
set -euo pipefail
bash "${PLATFORM_DIR}/scripts/integration/run-devsecops-ingest-container.sh"
'''
          }
        }
      }
    }
  }

  post {
    always {
      node('') {
        archiveArtifacts artifacts: 'results/**', allowEmptyArchive: true
        withCredentials([file(credentialsId: 'devsecops-jenkins-webhook-token', variable: 'JENKINS_WEBHOOK_TOKEN_FILE')]) {
          withEnv([
            "JENKINS_RESULT=${currentBuild.currentResult}",
            "JENKINS_DURATION_SECONDS=${(currentBuild.duration / 1000) as long}",
          ]) {
            sh '''#!/usr/bin/env bash
set -euo pipefail
python3 "${PLATFORM_DIR}/scripts/integration/notify-devsecops.py" \
  --job-key general \
  --default-job-name devsecops-ci \
  --trigger-type "${TRIGGER_TYPE:-jenkins}" \
  --metadata-file results/metadata/ingest-metadata.json \
  --token-file "${JENKINS_WEBHOOK_TOKEN_FILE}"
'''
          }
        }
        echo 'DevSecOps results archived.'
      }
    }
    success {
      echo 'Pipeline OK'
    }
    unstable {
      echo 'Pipeline UNSTABLE: review ETL or integration warnings.'
    }
    failure {
      echo 'Pipeline FAILED'
    }
  }
}
