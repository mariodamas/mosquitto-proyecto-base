pipeline {
    agent none

    options {
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '20'))
        skipDefaultCheckout(true)
    }

    triggers {
        /*
         * Ejecución mensual del job de monitorización.
         *
         * Se programa el día 2 de cada mes a las 08:00 para dejar margen a que:
         *  - el día 1 se genere el bundle en la máquina frontera;
         *  - se transfiera manualmente al entorno Jenkins;
         *  - el día 2 Jenkins lo importe y reevalúe los inventarios.
         */
        cron('0 8 2 * *')
    }

    parameters {
        string(
            name: 'PROJECT',
            defaultValue: 'mosquitto',
            description: 'Proyecto cuyos inventarios persistidos se reevaluarán.'
        )

        booleanParam(
            name: 'IMPORT_LATEST_BUNDLE',
            defaultValue: true,
            description: 'Importar el último bundle disponible antes de reevaluar. Si ya está activo, se omite la importación.'
        )
    }

    environment {
        LAB = '/opt/devsecops-lab'
        TARGET_PROJECT = "${params.PROJECT}"
    }

    stages {
        stage('Precheck') {
            agent any

            steps {
                sh '''#!/usr/bin/env bash
set -euo pipefail

echo "=== Monitoring precheck ==="
echo "LAB=${LAB}"
echo "TARGET_PROJECT=${TARGET_PROJECT}"

test -d "${LAB}"
test -d "${LAB}/artifacts/${TARGET_PROJECT}"
test -d "${LAB}/vuln-dbs/grype"
test -x "${LAB}/bin/import-vuln-bundle.sh"
test -x "${LAB}/bin/reevaluate-sboms.sh"

echo "=== Current persisted inventories ==="
find "${LAB}/artifacts/${TARGET_PROJECT}" -maxdepth 5 -type f | sort | sed -n '1,200p' || true

echo "=== Incoming bundles ==="
ls -lh "${LAB}/incoming-vuln-bundles" || true

echo "=== Active Grype bundle metadata, if available ==="
if [ -s "${LAB}/vuln-dbs/current-bundle-manifest.json" ]; then
  cat "${LAB}/vuln-dbs/current-bundle-manifest.json"
else
  echo "No active bundle manifest found yet."
fi
'''
            }
        }

        stage('Import latest bundle') {
            when {
                expression { return params.IMPORT_LATEST_BUNDLE }
            }

            agent any

            steps {
                sh '''#!/usr/bin/env bash
set -euo pipefail

echo "=== Import latest vulnerability bundle ==="

LATEST="$(ls -1t "${LAB}/incoming-vuln-bundles"/vuln-intel-bundle-*.tar.gz 2>/dev/null | head -1 || true)"

if [ -z "$LATEST" ]; then
  echo "No incoming bundle found. Continuing with current Grype DB."
  exit 0
fi

LATEST_SHA="${LATEST}.sha256"

if [ ! -s "$LATEST_SHA" ]; then
  echo "ERROR: checksum file not found for latest bundle: $LATEST_SHA"
  exit 1
fi

echo "Latest incoming bundle: $LATEST"
echo "Latest incoming checksum: $LATEST_SHA"

echo "=== Verifying external bundle checksum ==="
(
  cd "$(dirname "$LATEST")"
  sha256sum -c "$(basename "$LATEST_SHA")"
)

LATEST_NAME="$(basename "$LATEST" .tar.gz)"
CURRENT_MANIFEST="${LAB}/vuln-dbs/current-bundle-manifest.json"

CURRENT_NAME=""
if [ -s "$CURRENT_MANIFEST" ]; then
  CURRENT_NAME="$(python3 - <<PY
import json
from pathlib import Path

p = Path("$CURRENT_MANIFEST")
try:
    data = json.loads(p.read_text(encoding="utf-8"))
    print(data.get("bundle_name", ""))
except Exception:
    print("")
PY
)"
fi

echo "Latest incoming bundle name: ${LATEST_NAME}"
echo "Current active bundle name: ${CURRENT_NAME:-<none>}"

if [ "$LATEST_NAME" = "$CURRENT_NAME" ]; then
  echo "Latest incoming bundle is already active. Skipping import."
  exit 0
fi

echo "=== Importing new bundle ==="
"${LAB}/bin/import-vuln-bundle.sh" "$LATEST"

echo "=== Imported bundle metadata ==="
if [ -s "${LAB}/vuln-dbs/current-bundle-manifest.json" ]; then
  cat "${LAB}/vuln-dbs/current-bundle-manifest.json"
fi

echo "=== Active Grype DB status after import ==="
if command -v grype >/dev/null 2>&1; then
  export GRYPE_DB_AUTO_UPDATE=false
  export GRYPE_DB_CACHE_DIR="${LAB}/vuln-dbs/grype"
  export GRYPE_DB_MAX_ALLOWED_BUILT_AGE=720h
  grype db status -o json || true
else
  echo "grype is not installed on host. DB will be validated inside Docker in the next stage."
fi
'''
            }
        }

        stage('Reevaluate inventories') {
            agent {
                docker {
                    image 'devsecops-agente:1.0'
                    reuseNode true
                    args '-u 101:103 -v /opt/devsecops-lab:/opt/devsecops-lab:rw -e GRYPE_DB_AUTO_UPDATE=false -e GRYPE_DB_CACHE_DIR=/opt/devsecops-lab/vuln-dbs/grype -e GRYPE_DB_MAX_ALLOWED_BUILT_AGE=720h'
                }
            }

            steps {
                sh '''#!/usr/bin/env bash
set -euo pipefail

echo "=== Re-evaluating inventories ==="
echo "Project: ${TARGET_PROJECT}"

"${LAB}/bin/reevaluate-sboms.sh" "${TARGET_PROJECT}"
'''
            }
        }

        stage('Retention cleanup') {
            agent {
                docker {
                    image 'devsecops-agente:1.0'
                    reuseNode true
                    /*
                     * Se ejecuta como root dentro del contenedor para poder limpiar:
                     *  - incoming-vuln-bundles, normalmente propiedad de jenkins;
                     *  - imports, normalmente propiedad de jenkins;
                     *  - monitoring, generado por UID 101:103.
                     *
                     * No limpia /opt/devsecops-lab/artifacts, porque ahí están los
                     * inventarios históricos necesarios para reevaluación y ETL.
                     */
                    args '-u 0:0 -v /opt/devsecops-lab:/opt/devsecops-lab:rw'
                }
            }

            steps {
                sh '''#!/usr/bin/env bash
set -euo pipefail

echo "=== Applying monitoring retention policy ==="

if [ -x "${LAB}/bin/cleanup-monitoring-retention.sh" ]; then
  "${LAB}/bin/cleanup-monitoring-retention.sh" "${TARGET_PROJECT}"
else
  echo "WARNING: cleanup script not found or not executable: ${LAB}/bin/cleanup-monitoring-retention.sh"
fi
'''
            }
        }

        stage('Collect monitoring artifacts') {
            agent any

            steps {
                sh '''#!/usr/bin/env bash
set -euo pipefail

echo "=== Collect monitoring artifacts ==="

rm -rf monitoring-results
mkdir -p monitoring-results

if [ -d "${LAB}/monitoring/${TARGET_PROJECT}" ]; then
  cp -a "${LAB}/monitoring/${TARGET_PROJECT}/." monitoring-results/
else
  echo "WARNING: no monitoring directory found for project ${TARGET_PROJECT}"
fi

echo "=== Collected monitoring artifacts ==="
find monitoring-results -maxdepth 7 -type f | sort | sed -n '1,300p' || true
'''
            }
        }
    }

    post {
        always {
            node('') {
                archiveArtifacts artifacts: 'monitoring-results/**', allowEmptyArchive: true
                echo "Monitoring artifacts archived."
            }
        }

        success {
            echo 'Monitoring job OK'
        }

        failure {
            echo 'Monitoring job FAILED'
        }
    }
}
