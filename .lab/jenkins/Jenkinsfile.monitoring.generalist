pipeline {
  agent none

  options {
    timestamps()
    disableConcurrentBuilds()
    buildDiscarder(logRotator(numToKeepStr: '20'))
    skipDefaultCheckout(true)
  }

  triggers {
    cron('0 8 2 * *')
  }

  parameters {
    string(name: 'PROJECT', defaultValue: 'mosquitto', description: 'Project artifact namespace to re-evaluate')
    string(name: 'PROJECT_DB_NAME', defaultValue: 'mosquitto-proyecto-base', description: 'Project name used by the ETL database')
    string(name: 'PROJECT_REPO_URL', defaultValue: 'https://github.com/mariodamas/mosquitto-proyecto-base', description: 'Project repository URL')
    choice(name: 'REEVALUATE_SCOPE', choices: ['latest', 'all'], description: 'Re-evaluate every retained build or only the newest stored build')
    booleanParam(name: 'IMPORT_LATEST_BUNDLE', defaultValue: true, description: 'Import newest vulnerability bundle before reanalysis')
    booleanParam(name: 'RUN_ETL', defaultValue: true, description: 'Ingest offline reanalysis into PostgreSQL')
    booleanParam(name: 'RUN_RETENTION', defaultValue: true, description: 'Apply monitoring retention policy')
  }

  environment {
    LAB = '/opt/devsecops-lab'
    TARGET_PROJECT = "${params.PROJECT}"
    PLATFORM_DIR = '/opt/devsecops-lab/platform/devsecops_platform'
    // Constantes de plataforma (no se exponen en la UI):
    AGENT_IMAGE = 'devsecops-agente:1.0'
    INGESTOR_IMAGE = "${env.INGESTOR_IMAGE ?: 'cipherbit-ingestor:local'}"
    DEVSECOPS_DOCKER_NETWORK = "${env.DEVSECOPS_DOCKER_NETWORK ?: 'cipherbit_ingestion'}"
    DEVSECOPS_DB_HOST = 'postgres'
    DEVSECOPS_DB_PORT = '5432'
    DEVSECOPS_DB_NAME = 'cipherbit'
    DEVSECOPS_DB_USER = 'cipherbit_ingestor'
    // Endpoint de la plataforma: variable global de Jenkins reutilizada por todos
    // los proyectos; el fallback cubre ejecución local sin esa propiedad.
    DEVSECOPS_API_BASE_URL = "${env.DEVSECOPS_API_BASE_URL ?: 'http://127.0.0.1:3000/api/v1'}"
    DEVSECOPS_API_CONTAINER_BASE_URL = "${env.DEVSECOPS_API_CONTAINER_BASE_URL ?: 'http://backend:8000/api/v1'}"
  }

  stages {
    stage('Checkout') {
      agent any
      steps {
        checkout scm
          sh '''#!/usr/bin/env bash
set -euo pipefail
rm -rf monitoring-results
test -f .lab/ci/generate-etl-metadata.py
'''
      }
    }

    stage('Precheck') {
      agent any
      steps {
          sh '''#!/usr/bin/env bash
set -euo pipefail

case "${TARGET_PROJECT}" in
  .*|*..*|*[!A-Za-z0-9._-]*)
    echo "PROJECT must be a simple identifier, not a path" >&2
    exit 2
    ;;
esac

test -d "${LAB}"
test -d "${LAB}/artifacts/${TARGET_PROJECT}"
test -d "${LAB}/vuln-dbs/grype"
test -x "${LAB}/bin/import-vuln-bundle.sh"
test -x "${LAB}/bin/reevaluate-sboms.sh"

find "${LAB}/artifacts/${TARGET_PROJECT}" -maxdepth 3 -type d | sort | sed -n '1,120p'

if [ -s "${LAB}/vuln-dbs/current-bundle-manifest.json" ]; then
  cat "${LAB}/vuln-dbs/current-bundle-manifest.json"
else
  echo "No active bundle manifest found."
fi
'''
      }
    }

    stage('Import Bundle') {
      when { expression { params.IMPORT_LATEST_BUNDLE } }
      agent any
      steps {
          sh '''#!/usr/bin/env bash
set -euo pipefail

LATEST="$(ls -1t "${LAB}/incoming-vuln-bundles"/vuln-intel-bundle-*.tar.gz 2>/dev/null | head -1 || true)"
[ -n "${LATEST}" ] || { echo "No incoming bundle found; keeping current DB."; exit 0; }
test -s "${LATEST}.sha256"

(
  cd "$(dirname "${LATEST}")"
  sha256sum -c "$(basename "${LATEST}.sha256")"
)

LATEST_NAME="$(basename "${LATEST}" .tar.gz)"
CURRENT_MANIFEST="${LAB}/vuln-dbs/current-bundle-manifest.json"
CURRENT_NAME="$(python3 - <<PY
import json
from pathlib import Path
p = Path("${CURRENT_MANIFEST}")
if p.is_file():
    try:
        print(json.loads(p.read_text(encoding="utf-8")).get("bundle_name", ""))
    except Exception:
        print("")
else:
    print("")
PY
)"

if [ "${LATEST_NAME}" = "${CURRENT_NAME}" ]; then
  echo "Latest incoming bundle is already active."
  exit 0
fi

"${LAB}/bin/import-vuln-bundle.sh" "${LATEST}"
[ ! -s "${LAB}/vuln-dbs/current-bundle-manifest.json" ] || cat "${LAB}/vuln-dbs/current-bundle-manifest.json"
'''
      }
    }

    stage('Reevaluate Inventories') {
      agent {
        docker {
          image "${AGENT_IMAGE}"
          reuseNode true
          args '-u 101:103 --cap-drop ALL --security-opt no-new-privileges:true --pids-limit 1024 -v /opt/devsecops-lab/bin:/opt/devsecops-lab/bin:ro -v /opt/devsecops-lab/artifacts:/opt/devsecops-lab/artifacts:ro -v /opt/devsecops-lab/monitoring:/opt/devsecops-lab/monitoring:rw -v /opt/devsecops-lab/vuln-dbs:/opt/devsecops-lab/vuln-dbs:ro -e GRYPE_DB_AUTO_UPDATE=false -e GRYPE_DB_CACHE_DIR=/opt/devsecops-lab/vuln-dbs/grype -e GRYPE_DB_MAX_ALLOWED_BUILT_AGE=720h'
        }
      }
      steps {
          sh '''#!/usr/bin/env bash
set -euo pipefail
if [ "${REEVALUATE_SCOPE:-all}" = "all" ]; then
  "${LAB}/bin/reevaluate-sboms.sh" "${TARGET_PROJECT}"
else
  echo "REEVALUATE_SCOPE=latest: skipping project-wide reevaluate-sboms.sh; scoped Grype reanalysis runs in the next stage."
fi
'''
      }
    }

    stage('Prepare ETL Reanalysis') {
      agent {
        docker {
          image "${AGENT_IMAGE}"
          reuseNode true
          args '-u 101:103 --cap-drop ALL --security-opt no-new-privileges:true --pids-limit 1024 --network cipherbit_jenkins_api -v /opt/devsecops-lab/platform:/opt/devsecops-lab/platform:ro -v /opt/devsecops-lab/artifacts:/opt/devsecops-lab/artifacts:ro -v /opt/devsecops-lab/monitoring:/opt/devsecops-lab/monitoring:rw -v /opt/devsecops-lab/vuln-dbs:/opt/devsecops-lab/vuln-dbs:ro -e GRYPE_DB_AUTO_UPDATE=false -e GRYPE_DB_CACHE_DIR=/opt/devsecops-lab/vuln-dbs/grype -e GRYPE_DB_MAX_ALLOWED_BUILT_AGE=720h'
        }
      }
      steps {
        sh '''#!/usr/bin/env bash
set -euo pipefail
DEVSECOPS_API_BASE_URL="${DEVSECOPS_API_CONTAINER_BASE_URL}" \
  bash "${PLATFORM_DIR}/scripts/prepare-devsecops-monitoring-reanalysis.sh"
'''
      }
    }

    stage('ETL Offline Reanalysis') {
      when { expression { params.RUN_ETL } }
      agent any
      steps {
        catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
          withCredentials([file(credentialsId: 'devsecops-ingestor-db-password', variable: 'DEVSECOPS_DB_PASSWORD_FILE')]) {
            sh '''#!/usr/bin/env bash
set -euo pipefail
bash "${PLATFORM_DIR}/scripts/run-devsecops-ingest-container.sh" --mode monitoring
'''
          }
        }
      }
    }

    stage('Retention') {
      when { expression { params.RUN_RETENTION } }
      agent {
        docker {
          image "${AGENT_IMAGE}"
          reuseNode true
          args '-u 101:103 --cap-drop ALL --security-opt no-new-privileges:true --pids-limit 512 -v /opt/devsecops-lab/bin:/opt/devsecops-lab/bin:ro -v /opt/devsecops-lab/artifacts:/opt/devsecops-lab/artifacts:rw -v /opt/devsecops-lab/monitoring:/opt/devsecops-lab/monitoring:rw'
        }
      }
      steps {
          sh '''#!/usr/bin/env bash
set -euo pipefail
if [ -f "${LAB}/bin/cleanup-monitoring-retention.sh" ]; then
  bash "${LAB}/bin/cleanup-monitoring-retention.sh" "${TARGET_PROJECT}"
else
  echo "WARNING: cleanup script not found: ${LAB}/bin/cleanup-monitoring-retention.sh"
fi
'''
      }
    }

    stage('Collect Artifacts') {
      agent any
      steps {
        sh '''#!/usr/bin/env bash
set -euo pipefail
bash "${PLATFORM_DIR}/scripts/collect-devsecops-monitoring-artifacts.sh"
'''
      }
    }
  }

  post {
    always {
      node('') {
        archiveArtifacts artifacts: 'monitoring-results/**', allowEmptyArchive: true
        withCredentials([file(credentialsId: 'devsecops-jenkins-webhook-token', variable: 'JENKINS_WEBHOOK_TOKEN_FILE')]) {
          withEnv([
            "JENKINS_RESULT=${currentBuild.currentResult}",
            "JENKINS_DURATION_SECONDS=${(currentBuild.duration / 1000) as long}",
          ]) {
            sh '''#!/usr/bin/env bash
set -euo pipefail
python3 "${PLATFORM_DIR}/scripts/notify-devsecops.py" \
  --job-key monitoring \
  --default-job-name devsecops-monitoring \
  --trigger-type scheduled \
  --metadata-glob 'monitoring-results/**/ingest-metadata.json' \
  --metadata-glob "${LAB}/monitoring/${TARGET_PROJECT}/**/ingest-metadata.json" \
  --token-file "${JENKINS_WEBHOOK_TOKEN_FILE}"
'''
          }
        }
        echo 'Monitoring artifacts archived.'
      }
    }
    success {
      echo 'Monitoring job OK'
    }
    unstable {
      echo 'Monitoring job UNSTABLE: review ETL warnings.'
    }
    failure {
      echo 'Monitoring job FAILED'
    }
  }
}
